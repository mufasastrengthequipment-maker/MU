<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
<title>MUFASA — Media Player v3</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Anton&family=Barlow+Condensed:wght@300;400;600;700&family=Barlow:wght@300;400;500;600&display=swap" rel="stylesheet">
<!-- HLS.js for .m3u8 adaptive streams -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/hls.js/1.4.12/hls.min.js"></script>
<!-- dash.js for .mpd DASH streams -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/dashjs/4.7.0/dash.all.min.js"></script>
<style>
/* ══ MUFASA TOKENS ══ */
:root{
  --g:#D4942A;--gl:#F0B84A;--gd:#A8741F;
  --gdim:rgba(212,148,42,.2);--gfaint:rgba(212,148,42,.06);
  --bg:#050403;--s1:#0C0A08;--s2:#121008;
  --card:#18150F;--card2:#1F1B12;
  --b1:rgba(212,148,42,.13);--b2:rgba(212,148,42,.32);
  --w:#F4EFE4;--grey:#A09890;--dim:#7A7570;
  --r:6px;--r2:12px;
}
*,*::before,*::after{margin:0;padding:0;box-sizing:border-box;}
html,body{width:100%;height:100%;overflow:hidden;background:var(--bg);font-family:'Barlow',sans-serif;color:var(--w);-webkit-tap-highlight-color:transparent;}

/* ══ SHELL ══ */
#player{position:relative;width:100%;height:100%;display:flex;flex-direction:column;background:var(--bg);overflow:hidden;user-select:none;}
#ambience{position:absolute;inset:0;pointer-events:none;z-index:0;transition:opacity 1s;}
#player::before{content:'';position:absolute;inset:0;background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.04'/%3E%3C/svg%3E");opacity:.4;pointer-events:none;z-index:1;}

/* ══ VIDEO AREA ══ */
#vid-wrap{position:relative;flex:1;overflow:hidden;background:#000;z-index:2;cursor:pointer;min-height:0;}
#vid-wrap::after{content:'';position:absolute;bottom:0;left:0;right:0;height:40%;background:linear-gradient(to top,rgba(5,4,3,.85),transparent);pointer-events:none;z-index:3;}
video#mv{width:100%;height:100%;object-fit:contain;display:block;background:#000;}

/* Audio visualizer canvas — shown instead of black when audio-only */
#viz-canvas{position:absolute;inset:0;width:100%;height:100%;display:none;z-index:2;}
#player.audio-mode #viz-canvas{display:block;}
#player.audio-mode video#mv{opacity:0;}

/* play flash */
#play-overlay{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;z-index:5;opacity:0;pointer-events:none;}
#play-overlay.flash{animation:flashOut .55s ease forwards;}
@keyframes flashOut{0%{opacity:1;transform:scale(1)}50%{opacity:1;transform:scale(1.18)}100%{opacity:0;transform:scale(.82)}}
.play-ripple{width:70px;height:70px;border-radius:50%;background:rgba(212,148,42,.22);border:2px solid var(--g);display:flex;align-items:center;justify-content:center;font-size:1.7rem;}

/* spinner */
#spinner{position:absolute;inset:0;display:none;align-items:center;justify-content:center;z-index:6;flex-direction:column;gap:10px;}
#spinner.on{display:flex;}
.spin-ring{width:44px;height:44px;border:3px solid var(--b1);border-top-color:var(--g);border-radius:50%;animation:spin .8s linear infinite;}
@keyframes spin{to{transform:rotate(360deg)}}
.spin-label{font-family:'Barlow Condensed',sans-serif;font-size:.7rem;font-weight:700;letter-spacing:.18em;color:var(--g);text-transform:uppercase;}

/* now playing title */
#now-title{position:absolute;top:14px;left:14px;z-index:7;max-width:calc(100% - 120px);opacity:0;transform:translateY(-8px);transition:opacity .4s,transform .4s;pointer-events:none;}
#now-title.show{opacity:1;transform:translateY(0);}
.nt-badge{display:inline-flex;align-items:center;gap:6px;background:rgba(5,4,3,.88);border:1px solid var(--b2);border-radius:4px;padding:4px 10px;font-family:'Barlow Condensed',sans-serif;font-size:.68rem;font-weight:700;letter-spacing:.18em;text-transform:uppercase;color:var(--g);backdrop-filter:blur(12px);}
.nt-dot{width:6px;height:6px;background:var(--g);border-radius:50%;animation:blink 1.5s ease infinite;}
@keyframes blink{0%,100%{opacity:1}50%{opacity:.2}}
.nt-name{font-family:'Anton',sans-serif;font-size:1rem;letter-spacing:.04em;color:var(--w);margin-top:3px;text-shadow:0 2px 14px rgba(0,0,0,.9);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
.nt-type{font-family:'Barlow Condensed',sans-serif;font-size:.62rem;letter-spacing:.14em;color:var(--g);margin-top:2px;text-transform:uppercase;}

/* volume overlay */
#vol-area{position:absolute;top:14px;right:14px;z-index:7;display:flex;align-items:center;gap:8px;opacity:0;transform:translateY(-8px);transition:opacity .3s,transform .3s;}
#vid-wrap:hover #vol-area,#vid-wrap.touch-active #vol-area{opacity:1;transform:translateY(0);}
.vol-ico{font-size:1rem;color:var(--grey);cursor:pointer;transition:color .2s;user-select:none;}
.vol-ico:hover{color:var(--gl);}
#vol-slider{-webkit-appearance:none;appearance:none;width:80px;height:3px;background:var(--b1);border-radius:3px;outline:none;cursor:pointer;}
#vol-slider::-webkit-slider-thumb{-webkit-appearance:none;width:14px;height:14px;border-radius:50%;background:var(--g);cursor:pointer;box-shadow:0 0 6px rgba(212,148,42,.5);transition:transform .15s;}
#vol-slider::-webkit-slider-thumb:active{transform:scale(1.4);}

/* skip flash */
.sf{position:absolute;top:50%;transform:translateY(-50%);padding:8px 16px;background:rgba(212,148,42,.18);border:1px solid var(--b2);border-radius:var(--r);font-family:'Barlow Condensed',sans-serif;font-size:.88rem;font-weight:700;color:var(--gl);letter-spacing:.08em;z-index:8;opacity:0;pointer-events:none;transition:opacity .15s;}
#sf-l{left:18px;}#sf-r{right:18px;}

/* mobile touch zones */
#touch-left,#touch-right{position:absolute;top:0;bottom:0;width:35%;z-index:4;display:none;}
#touch-left{left:0;}#touch-right{right:0;}
.touch-hint{position:absolute;top:50%;transform:translateY(-50%);font-family:'Barlow Condensed',sans-serif;font-size:.75rem;font-weight:700;letter-spacing:.1em;color:rgba(240,184,74,.6);pointer-events:none;opacity:0;transition:opacity .2s;}
#touch-left .touch-hint{left:14px;}
#touch-right .touch-hint{right:14px;}

/* mobile swipe-volume indicator */
#swipe-vol{position:absolute;right:20px;top:50%;transform:translateY(-50%);background:rgba(5,4,3,.85);border:1px solid var(--b2);border-radius:var(--r);padding:6px 10px;display:none;flex-direction:column;align-items:center;gap:4px;z-index:9;min-width:44px;}
#swipe-vol.show{display:flex;}
.sv-label{font-family:'Barlow Condensed',sans-serif;font-size:.62rem;font-weight:700;letter-spacing:.14em;color:var(--dim);text-transform:uppercase;}
.sv-bar{width:6px;height:60px;background:var(--b1);border-radius:3px;position:relative;overflow:hidden;}
.sv-fill{position:absolute;bottom:0;left:0;right:0;background:linear-gradient(to top,var(--gd),var(--gl));border-radius:3px;transition:height .1s;}
.sv-pct{font-family:'Barlow Condensed',sans-serif;font-size:.72rem;font-weight:700;color:var(--gl);}

/* chapter overlay */
#chapter-overlay{position:absolute;bottom:8px;left:50%;transform:translateX(-50%) translateY(4px);z-index:7;opacity:0;transition:opacity .3s,transform .3s;pointer-events:none;}
#chapter-label{background:rgba(5,4,3,.9);border:1px solid var(--b2);border-radius:4px;padding:4px 12px;font-family:'Barlow Condensed',sans-serif;font-size:.74rem;font-weight:700;letter-spacing:.14em;color:var(--g);backdrop-filter:blur(10px);white-space:nowrap;}
#chapter-overlay.show{opacity:1;transform:translateX(-50%) translateY(0);}

/* subtitles */
#sub-display{position:absolute;bottom:8px;left:50%;transform:translateX(-50%);z-index:9;text-align:center;pointer-events:none;max-width:92%;width:max-content;}
.sub-line{display:inline-block;background:rgba(0,0,0,.85);color:#fff;font-family:'Barlow',sans-serif;font-size:.9rem;font-weight:500;padding:3px 11px;border-radius:4px;line-height:1.55;margin:1px 0;}

/* badges */
#pip-badge{position:absolute;top:14px;left:50%;transform:translateX(-50%);background:rgba(5,4,3,.9);border:1px solid var(--b2);border-radius:4px;padding:4px 12px;font-family:'Barlow Condensed',sans-serif;font-size:.68rem;font-weight:700;letter-spacing:.14em;color:var(--g);z-index:8;display:none;}
#pip-badge.show{display:block;}
#admin-badge{position:absolute;bottom:10px;right:10px;background:rgba(212,148,42,.12);border:1px solid var(--b2);border-radius:4px;padding:3px 9px;font-family:'Barlow Condensed',sans-serif;font-size:.62rem;font-weight:700;letter-spacing:.14em;color:var(--g);z-index:8;display:none;}
#admin-badge.show{display:block;}
#hls-badge{position:absolute;top:14px;right:110px;background:rgba(212,148,42,.12);border:1px solid var(--b2);border-radius:4px;padding:3px 8px;font-family:'Barlow Condensed',sans-serif;font-size:.62rem;font-weight:700;letter-spacing:.12em;color:var(--g);z-index:8;display:none;}
#hls-badge.show{display:block;}

/* ══ CONTROLS ══ */
#controls{position:relative;z-index:10;background:var(--s1);border-top:1px solid var(--b1);padding:8px 14px 10px;flex-shrink:0;}
#prog-wrap{position:relative;height:4px;background:var(--b1);border-radius:4px;cursor:pointer;margin-bottom:9px;transition:height .15s;}
#prog-wrap:hover,#prog-wrap.dragging{height:7px;}
#prog-buf{position:absolute;top:0;left:0;height:100%;background:rgba(212,148,42,.16);border-radius:4px;pointer-events:none;}
#prog-fill{position:absolute;top:0;left:0;height:100%;background:linear-gradient(90deg,var(--gd),var(--gl));border-radius:4px;pointer-events:none;}
#prog-thumb{position:absolute;top:50%;width:14px;height:14px;background:var(--gl);border-radius:50%;transform:translate(-50%,-50%) scale(0);pointer-events:none;box-shadow:0 0 10px rgba(212,148,42,.7);transition:transform .15s;}
#prog-wrap:hover #prog-thumb,#prog-wrap.dragging #prog-thumb{transform:translate(-50%,-50%) scale(1);}
#prog-tip{position:absolute;top:-30px;background:var(--card2);border:1px solid var(--b2);border-radius:4px;padding:2px 8px;font-family:'Barlow Condensed',sans-serif;font-size:.68rem;font-weight:600;color:var(--gl);white-space:nowrap;transform:translateX(-50%);pointer-events:none;opacity:0;transition:opacity .15s;}
#prog-wrap:hover #prog-tip{opacity:1;}
.ch-dot{position:absolute;top:50%;width:9px;height:9px;background:var(--g);border-radius:50%;transform:translate(-50%,-50%);pointer-events:all;cursor:pointer;z-index:5;transition:transform .15s,box-shadow .15s;}
.ch-dot:hover{transform:translate(-50%,-50%) scale(1.7);box-shadow:0 0 10px var(--g);}
.ch-dot-tip{position:absolute;bottom:16px;white-space:nowrap;background:var(--card2);border:1px solid var(--b2);border-radius:4px;padding:2px 7px;font-family:'Barlow Condensed',sans-serif;font-size:.64rem;color:var(--gl);transform:translateX(-50%);left:50%;display:none;z-index:10;pointer-events:none;}
.ch-dot:hover .ch-dot-tip{display:block;}

.ctrl-row{display:flex;align-items:center;gap:4px;}
.ctrl-btn{background:none;border:none;cursor:pointer;color:var(--grey);font-size:.95rem;padding:6px;border-radius:var(--r);transition:color .2s,background .2s,transform .12s;line-height:1;display:flex;align-items:center;justify-content:center;user-select:none;flex-shrink:0;-webkit-tap-highlight-color:transparent;}
.ctrl-btn:hover{color:var(--gl);background:var(--gfaint);}
.ctrl-btn:active{transform:scale(.88);}
.ctrl-btn.active{color:var(--g);}
#btn-play{width:44px;height:44px;border-radius:50%;background:linear-gradient(135deg,var(--gd),var(--gl));color:var(--bg);font-size:1.15rem;border:none;cursor:pointer;transition:box-shadow .25s,transform .12s;box-shadow:0 4px 20px rgba(212,148,42,.38);display:flex;align-items:center;justify-content:center;flex-shrink:0;}
#btn-play:hover{transform:scale(1.08);box-shadow:0 6px 26px rgba(212,148,42,.58);}
#btn-play:active{transform:scale(.93);}
.time-disp{font-family:'Barlow Condensed',sans-serif;font-size:.75rem;font-weight:600;letter-spacing:.06em;color:var(--grey);white-space:nowrap;flex-shrink:0;padding:0 2px;}
.time-disp span{color:var(--dim);}
#speed-btn{font-family:'Barlow Condensed',sans-serif;font-size:.68rem;font-weight:700;letter-spacing:.08em;padding:3px 7px;border:1px solid var(--b2);border-radius:4px;background:none;color:var(--grey);cursor:pointer;transition:all .2s;flex-shrink:0;user-select:none;}
#speed-btn:hover{color:var(--gl);border-color:var(--g);background:var(--gfaint);}
#qual-btn{font-family:'Barlow Condensed',sans-serif;font-size:.66rem;font-weight:700;letter-spacing:.08em;padding:3px 7px;border:1px solid var(--b1);border-radius:4px;background:rgba(212,148,42,.08);color:var(--g);flex-shrink:0;cursor:default;}

/* ══ URL BAR ══ */
#url-bar{position:relative;z-index:10;background:var(--s2);border-top:1px solid var(--b1);padding:6px 14px;display:flex;gap:8px;align-items:center;flex-shrink:0;}
#url-bar label{font-family:'Barlow Condensed',sans-serif;font-size:.66rem;font-weight:700;letter-spacing:.18em;text-transform:uppercase;color:var(--dim);white-space:nowrap;flex-shrink:0;}
#url-in{flex:1;background:var(--card);border:1px solid var(--b1);border-radius:var(--r);color:var(--w);padding:5px 9px;font-family:'Barlow',sans-serif;font-size:.76rem;outline:none;transition:border-color .2s;min-width:0;}
#url-in:focus{border-color:var(--g);}
#url-in::placeholder{color:var(--dim);}
#url-go{background:linear-gradient(135deg,var(--gd),var(--gl));border:none;color:var(--bg);font-family:'Barlow Condensed',sans-serif;font-size:.68rem;font-weight:700;letter-spacing:.12em;text-transform:uppercase;padding:5px 13px;border-radius:var(--r);cursor:pointer;transition:all .2s;white-space:nowrap;flex-shrink:0;}
#url-go:hover{box-shadow:0 4px 14px rgba(212,148,42,.4);transform:translateY(-1px);}

/* ══ PLAYLIST ══ */
#playlist{position:relative;z-index:10;background:var(--s1);border-top:1px solid var(--b1);flex-shrink:0;max-height:165px;overflow-y:auto;scrollbar-width:thin;scrollbar-color:var(--b2) transparent;}
#playlist::-webkit-scrollbar{width:4px;}
#playlist::-webkit-scrollbar-track{background:transparent;}
#playlist::-webkit-scrollbar-thumb{background:var(--b2);border-radius:4px;}
.pl-header{display:flex;align-items:center;justify-content:space-between;padding:5px 14px 4px;position:sticky;top:0;background:var(--s1);border-bottom:1px solid var(--b1);z-index:2;}
.pl-title{font-family:'Barlow Condensed',sans-serif;font-size:.66rem;font-weight:700;letter-spacing:.22em;text-transform:uppercase;color:var(--dim);}
.pl-actions{display:flex;align-items:center;gap:9px;}
.pl-count{font-family:'Barlow Condensed',sans-serif;font-size:.64rem;color:var(--g);letter-spacing:.1em;}
.pl-clr{font-family:'Barlow Condensed',sans-serif;font-size:.62rem;color:var(--dim);cursor:pointer;padding:2px 6px;border:1px solid var(--b1);border-radius:3px;transition:all .2s;}
.pl-clr:hover{color:var(--gl);border-color:var(--b2);}
.pl-item{display:flex;align-items:center;gap:9px;padding:6px 14px;cursor:pointer;border-bottom:1px solid rgba(212,148,42,.05);transition:background .2s;position:relative;}
.pl-item:hover{background:var(--gfaint);}
.pl-item.active{background:var(--gdim);border-left:2px solid var(--g);padding-left:12px;}
.pl-idx{font-family:'Barlow Condensed',sans-serif;font-size:.68rem;font-weight:600;color:var(--dim);width:16px;text-align:right;flex-shrink:0;position:relative;height:16px;}
.pl-bars{display:none;align-items:flex-end;gap:2px;height:12px;position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);}
.pl-item.active .pl-bars{display:flex;}
.pl-item.active .pl-num-txt{visibility:hidden;}
.pl-bar{width:3px;background:var(--g);border-radius:1px;height:8px;}
.pl-bar:nth-child(1){animation:bb .65s ease-in-out infinite alternate;}
.pl-bar:nth-child(2){animation:bb .65s .15s ease-in-out infinite alternate;}
.pl-bar:nth-child(3){animation:bb .65s .3s ease-in-out infinite alternate;}
@keyframes bb{from{transform:scaleY(.25)}to{transform:scaleY(1)}}
.pl-thumb{width:50px;height:32px;background:var(--card2);border-radius:3px;flex-shrink:0;overflow:hidden;border:1px solid var(--b1);display:flex;align-items:center;justify-content:center;font-size:.8rem;color:var(--dim);position:relative;}
.pl-item.active .pl-thumb{border-color:var(--g);}
.pl-thumb img{width:100%;height:100%;object-fit:cover;display:block;}
.pl-thumb-dur{position:absolute;bottom:1px;right:2px;font-family:'Barlow Condensed',sans-serif;font-size:.52rem;font-weight:700;background:rgba(0,0,0,.78);color:var(--w);padding:1px 3px;border-radius:2px;}
.pl-info{flex:1;min-width:0;}
.pl-name{font-family:'Barlow Condensed',sans-serif;font-size:.78rem;font-weight:600;color:var(--w);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;letter-spacing:.02em;}
.pl-item.active .pl-name{color:var(--gl);}
.pl-meta{font-size:.62rem;color:var(--dim);margin-top:1px;font-family:'Barlow Condensed',sans-serif;letter-spacing:.06em;}
.pl-dur{font-family:'Barlow Condensed',sans-serif;font-size:.68rem;color:var(--dim);flex-shrink:0;}
.pl-item.active .pl-dur{color:var(--g);}
.pl-rm{background:none;border:none;color:var(--dim);cursor:pointer;font-size:.7rem;padding:3px 5px;border-radius:3px;transition:color .2s,background .2s;flex-shrink:0;opacity:0;}
.pl-item:hover .pl-rm{opacity:1;}
.pl-rm:hover{color:#ff5f5f;background:rgba(255,95,95,.1);}

/* ══ AUDIO VISUALIZER ══ */
/* canvas is handled via JS, styles above */

/* ══ DROP ZONE ══ */
#drop-zone{position:absolute;inset:0;z-index:50;background:rgba(5,4,3,.93);backdrop-filter:blur(14px);display:flex;align-items:center;justify-content:center;flex-direction:column;gap:14px;opacity:0;pointer-events:none;transition:opacity .25s;}
#drop-zone.over{opacity:1;pointer-events:all;}
.dz-inner{border:2px dashed var(--g);border-radius:var(--r2);padding:28px 42px;text-align:center;display:flex;flex-direction:column;align-items:center;gap:10px;animation:dzPulse 2s ease-in-out infinite;}
@keyframes dzPulse{0%,100%{border-color:var(--g);box-shadow:0 0 0 rgba(212,148,42,0)}50%{border-color:var(--gl);box-shadow:0 0 24px rgba(212,148,42,.22)}}
.dz-label{font-family:'Anton',sans-serif;font-size:1.4rem;letter-spacing:.06em;color:var(--g);}
.dz-sub{font-family:'Barlow Condensed',sans-serif;font-size:.78rem;color:var(--grey);letter-spacing:.12em;}

/* ══ PLACEHOLDER ══ */
#placeholder{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:13px;z-index:4;pointer-events:none;transition:opacity .3s;}
#placeholder.hidden{opacity:0;pointer-events:none;}
.ph-lion{font-size:3rem;opacity:.14;animation:lionf 6s ease-in-out infinite;}
@keyframes lionf{0%,100%{transform:translateY(0)}50%{transform:translateY(-10px)}}
.ph-text{font-family:'Anton',sans-serif;font-size:1.3rem;letter-spacing:.1em;color:var(--w);opacity:.22;text-align:center;}
.ph-sub{font-family:'Barlow Condensed',sans-serif;font-size:.72rem;letter-spacing:.2em;color:var(--dim);text-transform:uppercase;}
.ph-btns{display:flex;gap:9px;flex-wrap:wrap;justify-content:center;pointer-events:all;margin-top:4px;}
.ph-btn{background:linear-gradient(135deg,var(--gd),var(--gl));color:var(--bg);font-family:'Barlow Condensed',sans-serif;font-size:.74rem;font-weight:700;letter-spacing:.14em;text-transform:uppercase;padding:8px 17px;border:none;border-radius:var(--r);cursor:pointer;transition:all .25s;box-shadow:0 4px 14px rgba(212,148,42,.25);}
.ph-btn:hover{transform:translateY(-2px);box-shadow:0 8px 26px rgba(212,148,42,.42);}
.ph-btn-o{background:none;color:var(--gl);font-family:'Barlow Condensed',sans-serif;font-size:.74rem;font-weight:700;letter-spacing:.14em;text-transform:uppercase;padding:7px 15px;border:1px solid var(--b2);border-radius:var(--r);cursor:pointer;transition:all .25s;}
.ph-btn-o:hover{background:var(--gfaint);border-color:var(--g);}

/* ══ TOAST ══ */
#toast{position:absolute;bottom:65px;left:50%;transform:translateX(-50%) translateY(8px);background:var(--card2);border:1px solid var(--b2);border-radius:var(--r);padding:6px 15px;font-family:'Barlow Condensed',sans-serif;font-size:.76rem;font-weight:600;letter-spacing:.08em;color:var(--gl);z-index:25;opacity:0;pointer-events:none;transition:opacity .25s,transform .25s;white-space:nowrap;max-width:90vw;overflow:hidden;text-overflow:ellipsis;}
#toast.show{opacity:1;transform:translateX(-50%) translateY(0);}

/* ══ PANELS ══ */
.panel{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%) scale(.92);background:rgba(5,4,3,.97);border:1px solid var(--b2);border-radius:var(--r2);padding:18px 22px;z-index:30;opacity:0;pointer-events:none;transition:opacity .25s,transform .25s;backdrop-filter:blur(16px);}
.panel.show{opacity:1;transform:translate(-50%,-50%) scale(1);pointer-events:all;}
.panel-title{font-family:'Anton',sans-serif;font-size:.92rem;letter-spacing:.1em;color:var(--g);margin-bottom:12px;display:flex;justify-content:space-between;align-items:center;}
.panel-close{cursor:pointer;font-size:.8rem;color:var(--grey);padding:2px 5px;border-radius:3px;transition:color .2s,background .2s;}
.panel-close:hover{color:var(--gl);background:var(--gfaint);}

/* keyboard shortcuts */
#kbs{width:230px;}
.kb-row{display:flex;justify-content:space-between;align-items:center;padding:3px 0;border-bottom:1px solid var(--b1);gap:12px;}
.kb-row:last-child{border-bottom:none;}
.kb-key{background:var(--card2);border:1px solid var(--b2);border-radius:3px;padding:2px 6px;font-family:'Barlow Condensed',sans-serif;font-size:.65rem;font-weight:700;color:var(--g);min-width:28px;text-align:center;}
.kb-desc{font-family:'Barlow Condensed',sans-serif;font-size:.7rem;color:var(--grey);letter-spacing:.04em;}

/* chapter panel */
#ch-panel{width:300px;max-width:95vw;}
.ch-list{max-height:145px;overflow-y:auto;margin-bottom:10px;scrollbar-width:thin;scrollbar-color:var(--b2) transparent;}
.ch-entry{display:flex;align-items:center;gap:8px;padding:4px 0;border-bottom:1px solid var(--b1);font-family:'Barlow Condensed',sans-serif;font-size:.76rem;}
.ch-entry:last-child{border-bottom:none;}
.ch-time{color:var(--g);font-weight:700;flex-shrink:0;cursor:pointer;transition:color .2s;}
.ch-time:hover{color:var(--gl);text-decoration:underline;}
.ch-lbl{flex:1;color:var(--w);}
.ch-del{background:none;border:none;color:var(--dim);cursor:pointer;font-size:.72rem;transition:color .2s;}
.ch-del:hover{color:#ff5f5f;}
.ch-add-row{display:flex;gap:6px;margin-top:6px;}
.ch-inp{background:var(--card);border:1px solid var(--b1);border-radius:var(--r);color:var(--w);padding:5px 8px;font-family:'Barlow',sans-serif;font-size:.74rem;outline:none;transition:border-color .2s;flex:1;min-width:0;}
.ch-inp:focus{border-color:var(--g);}
.ch-inp::placeholder{color:var(--dim);}
.ch-add-btn{background:var(--gdim);border:1px solid var(--b2);color:var(--gl);font-family:'Barlow Condensed',sans-serif;font-size:.7rem;font-weight:700;letter-spacing:.08em;padding:5px 10px;border-radius:var(--r);cursor:pointer;transition:all .2s;white-space:nowrap;}
.ch-add-btn:hover{background:var(--g);color:var(--bg);}
.ch-save-note{font-family:'Barlow Condensed',sans-serif;font-size:.64rem;color:var(--dim);margin-top:6px;letter-spacing:.06em;}
.ch-save-note span{color:var(--g);}

/* subtitle panel */
#sub-panel{width:315px;max-width:95vw;}
.sub-status{font-family:'Barlow Condensed',sans-serif;font-size:.74rem;color:var(--dim);margin-bottom:10px;letter-spacing:.05em;}
.sub-status span{color:var(--g);}
.sub-row{display:flex;gap:8px;align-items:center;margin-bottom:8px;}
.sub-row label{font-family:'Barlow Condensed',sans-serif;font-size:.66rem;color:var(--grey);letter-spacing:.1em;white-space:nowrap;}
.sub-file-btn{background:var(--gdim);border:1px solid var(--b2);color:var(--gl);font-family:'Barlow Condensed',sans-serif;font-size:.7rem;font-weight:700;letter-spacing:.1em;padding:5px 11px;border-radius:var(--r);cursor:pointer;transition:all .2s;}
.sub-file-btn:hover{background:var(--g);color:var(--bg);}
.sub-toggle{display:flex;align-items:center;gap:8px;margin-top:4px;}
.sub-toggle label{font-family:'Barlow Condensed',sans-serif;font-size:.72rem;color:var(--grey);}
.tog{width:34px;height:18px;background:var(--b1);border-radius:10px;position:relative;cursor:pointer;transition:background .2s;border:1px solid var(--b2);flex-shrink:0;}
.tog.on{background:var(--gdim);border-color:var(--g);}
.tog::after{content:'';position:absolute;top:2px;left:2px;width:12px;height:12px;background:var(--dim);border-radius:50%;transition:transform .2s,background .2s;}
.tog.on::after{transform:translateX(16px);background:var(--g);}

/* viz panel */
#viz-panel{width:280px;max-width:95vw;}
.viz-modes{display:flex;flex-wrap:wrap;gap:6px;margin-bottom:4px;}
.viz-mode-btn{background:var(--card2);border:1px solid var(--b1);border-radius:var(--r);color:var(--grey);font-family:'Barlow Condensed',sans-serif;font-size:.68rem;font-weight:700;letter-spacing:.1em;padding:5px 10px;cursor:pointer;transition:all .2s;text-transform:uppercase;}
.viz-mode-btn:hover{color:var(--gl);border-color:var(--b2);}
.viz-mode-btn.active{background:var(--gdim);border-color:var(--g);color:var(--g);}

/* fullscreen */
:fullscreen #controls,:fullscreen #url-bar,:fullscreen #playlist{display:none;}
:-webkit-full-screen #controls,:-webkit-full-screen #url-bar,:-webkit-full-screen #playlist{display:none;}
:fullscreen #vid-wrap,:-webkit-full-screen #vid-wrap{flex:1;}
:fullscreen #vol-area,:-webkit-full-screen #vol-area{opacity:1!important;transform:translateY(0)!important;}
:fullscreen #touch-left,:fullscreen #touch-right,:-webkit-full-screen #touch-left,:-webkit-full-screen #touch-right{display:block;}

/* fullscreen floating controls */
#fs-controls{position:absolute;bottom:0;left:0;right:0;z-index:20;padding:10px 16px 14px;background:linear-gradient(to top,rgba(5,4,3,.95),transparent);opacity:0;transform:translateY(8px);transition:opacity .3s,transform .3s;pointer-events:none;display:none;}
:fullscreen #fs-controls,:-webkit-full-screen #fs-controls{display:block;}
#vid-wrap:hover #fs-controls,:fullscreen #vid-wrap:hover #fs-controls{opacity:1;transform:translateY(0);pointer-events:all;}
.fs-prog{position:relative;height:4px;background:var(--b1);border-radius:4px;cursor:pointer;margin-bottom:8px;transition:height .15s;}
.fs-prog:hover{height:7px;}
.fs-pb{position:absolute;top:0;left:0;height:100%;background:rgba(212,148,42,.16);border-radius:4px;}
.fs-pf{position:absolute;top:0;left:0;height:100%;background:linear-gradient(90deg,var(--gd),var(--gl));border-radius:4px;}
.fs-thumb{position:absolute;top:50%;width:14px;height:14px;background:var(--gl);border-radius:50%;transform:translate(-50%,-50%) scale(0);pointer-events:none;box-shadow:0 0 10px rgba(212,148,42,.7);transition:transform .15s;}
.fs-prog:hover .fs-thumb{transform:translate(-50%,-50%) scale(1);}
.fs-row{display:flex;align-items:center;gap:6px;justify-content:space-between;}
</style>
</head>
<body>
<div id="player">
  <div id="ambience"></div>

  <!-- DROP ZONE -->
  <div id="drop-zone">
    <div class="dz-inner">
      <div style="font-size:2.6rem">🎬</div>
      <div class="dz-label">DROP TO PLAY</div>
      <div class="dz-sub">VIDEO · AUDIO · HLS · DASH · URL</div>
    </div>
  </div>

  <!-- VIDEO -->
  <div id="vid-wrap">
    <video id="mv" preload="metadata" playsinline></video>
    <canvas id="viz-canvas"></canvas>

    <!-- Placeholder -->
    <div id="placeholder">
      <div class="ph-lion">🦁</div>
      <div class="ph-text">MUFASA PLAYER</div>
      <div class="ph-sub">v3 · HLS · DASH · Visualizer · Mobile</div>
      <div class="ph-btns">
        <button class="ph-btn" onclick="document.getElementById('file-in').click()">📁 Open File</button>
        <button class="ph-btn" onclick="document.getElementById('folder-in').click()">📂 Open Folder</button>
        <button class="ph-btn-o" onclick="loadDemo()">▶ Demo</button>
      </div>
    </div>

    <!-- Now playing -->
    <div id="now-title">
      <div class="nt-badge"><span class="nt-dot"></span>NOW PLAYING</div>
      <div class="nt-name" id="nt-name">—</div>
      <div class="nt-type" id="nt-type"></div>
    </div>

    <!-- Volume -->
    <div id="vol-area">
      <span class="vol-ico" id="vol-ico" onclick="toggleMute()">🔊</span>
      <input type="range" id="vol-slider" min="0" max="1" step="0.01" value="1">
    </div>

    <!-- Play flash -->
    <div id="play-overlay"><div class="play-ripple" id="play-icon">▶</div></div>

    <!-- Spinner -->
    <div id="spinner"><div class="spin-ring"></div><span class="spin-label" id="spin-label">Loading</span></div>

    <!-- Skip flashes -->
    <div class="sf" id="sf-l">◀◀ 10s</div>
    <div class="sf" id="sf-r">▶▶ 10s</div>

    <!-- Mobile touch zones -->
    <div id="touch-left"><span class="touch-hint">◀◀ Double tap</span></div>
    <div id="touch-right"><span class="touch-hint">Double tap ▶▶</span></div>

    <!-- Mobile swipe volume -->
    <div id="swipe-vol">
      <span class="sv-label">VOL</span>
      <div class="sv-bar"><div class="sv-fill" id="sv-fill"></div></div>
      <span class="sv-pct" id="sv-pct">100%</span>
    </div>

    <!-- Overlays -->
    <div id="chapter-overlay"><span id="chapter-label"></span></div>
    <div id="sub-display"></div>
    <div id="pip-badge">📺 PICTURE IN PICTURE</div>
    <div id="hls-badge">HLS</div>
    <div id="admin-badge">⚡ ADMIN LINKED</div>

    <!-- Fullscreen floating controls -->
    <div id="fs-controls">
      <div class="fs-prog" id="fs-prog">
        <div class="fs-pb" id="fs-pb"></div>
        <div class="fs-pf" id="fs-pf"></div>
        <div class="fs-thumb" id="fs-thumb"></div>
      </div>
      <div class="fs-row">
        <div class="ctrl-row" style="gap:4px;">
          <button class="ctrl-btn" onclick="skipTrack(-1)">⏮</button>
          <button class="ctrl-btn" onclick="skipTime(-10)">⏪</button>
          <button id="fs-play" class="ctrl-btn" style="width:38px;height:38px;border-radius:50%;background:linear-gradient(135deg,var(--gd),var(--gl));color:var(--bg);font-size:1rem;" onclick="togglePlay()">▶</button>
          <button class="ctrl-btn" onclick="skipTime(10)">⏩</button>
          <button class="ctrl-btn" onclick="skipTrack(1)">⏭</button>
        </div>
        <div class="time-disp"><span id="fs-cur">0:00</span><span> / </span><span id="fs-dur">0:00</span></div>
        <div class="ctrl-row" style="gap:4px;">
          <button class="ctrl-btn" onclick="toggleLoop()" id="fs-loop">🔁</button>
          <button id="fs-speed" class="ctrl-btn" style="font-family:'Barlow Condensed',sans-serif;font-size:.7rem;font-weight:700;border:1px solid var(--b2);border-radius:4px;" onclick="cycleSpeed()">1×</button>
          <button class="ctrl-btn" onclick="toggleFullscreen()">✕</button>
        </div>
      </div>
    </div>
  </div>

  <!-- CONTROLS -->
  <div id="controls">
    <div id="prog-wrap">
      <div id="prog-buf"></div>
      <div id="prog-fill"></div>
      <div id="prog-thumb"></div>
      <div id="prog-tip">0:00</div>
    </div>
    <div class="ctrl-row" style="justify-content:space-between;">
      <div class="ctrl-row" style="gap:3px;">
        <button class="ctrl-btn" onclick="skipTrack(-1)" title="Prev (P)">⏮</button>
        <button class="ctrl-btn" onclick="skipTime(-10)" title="Back 10s (←)">⏪</button>
        <button id="btn-play" onclick="togglePlay()">▶</button>
        <button class="ctrl-btn" onclick="skipTime(10)" title="Fwd 10s (→)">⏩</button>
        <button class="ctrl-btn" onclick="skipTrack(1)" title="Next (N)">⏭</button>
      </div>
      <div class="time-disp"><span id="t-cur">0:00</span><span> / </span><span id="t-dur">0:00</span></div>
      <div class="ctrl-row" style="gap:3px;flex-wrap:wrap;">
        <span id="qual-btn">HD</span>
        <button id="speed-btn" onclick="cycleSpeed()">1×</button>
        <button class="ctrl-btn" id="loop-btn" onclick="toggleLoop()" title="Loop single (L)">🔁</button>
        <button class="ctrl-btn" id="repeat-btn" onclick="toggleRepeatAll()" title="Repeat playlist (R)">🔂</button>
        <button class="ctrl-btn" id="shuffle-btn" onclick="toggleShuffle()" title="Shuffle (Z)">🔀</button>
        <button class="ctrl-btn" onclick="toggleSubPanel()" title="Subtitles (C)">💬</button>
        <button class="ctrl-btn" onclick="toggleChPanel()" title="Chapters (H)">📍</button>
        <button class="ctrl-btn" onclick="toggleVizPanel()" title="Visualizer (V)" id="viz-panel-btn">📊</button>
        <button class="ctrl-btn" onclick="togglePiP()" title="PiP (I)">📺</button>
        <button class="ctrl-btn" onclick="document.getElementById('file-in').click()" title="Open file (O)">📁</button>
        <button class="ctrl-btn" onclick="document.getElementById('folder-in').click()" title="Open folder">📂</button>
        <button class="ctrl-btn" onclick="saveNamedPlaylist()" title="Save playlist">💾</button>
        <button class="ctrl-btn" onclick="toggleKbs()" title="Shortcuts (?)">⌨</button>
        <button class="ctrl-btn" onclick="toggleFullscreen()" title="Fullscreen (F)">⛶</button>
      </div>
    </div>
  </div>

  <!-- URL BAR -->
  <div id="url-bar">
    <label>URL</label>
    <input type="text" id="url-in" placeholder="Paste MP4, HLS (.m3u8), DASH (.mpd), MP3 URL…" autocomplete="off" spellcheck="false">
    <button id="url-go" onclick="loadFromURL()">Load</button>
  </div>

  <!-- PLAYLIST -->
  <div id="playlist">
    <div class="pl-header">
      <span class="pl-title">Playlist</span>
      <div class="pl-actions">
        <span class="pl-count" id="pl-count">0 ITEMS</span>
        <span class="pl-clr" onclick="sortPlaylist()" title="Sort A–Z">A-Z</span>
        <span class="pl-clr" onclick="loadNamedPlaylist()" title="Load saved">LOAD</span>
        <span class="pl-clr" onclick="clearPlaylist()">CLEAR</span>
      </div>
    </div>
    <div id="pl-list"></div>
  </div>

  <!-- PANELS -->
  <div id="kbs" class="panel">
    <div class="panel-title">SHORTCUTS <span class="panel-close" onclick="toggleKbs()">✕</span></div>
    <div class="kb-row"><span class="kb-key">Space</span><span class="kb-desc">Play / Pause</span></div>
    <div class="kb-row"><span class="kb-key">← →</span><span class="kb-desc">Seek ±10s</span></div>
    <div class="kb-row"><span class="kb-key">↑ ↓</span><span class="kb-desc">Volume ±10%</span></div>
    <div class="kb-row"><span class="kb-key">M</span><span class="kb-desc">Mute toggle</span></div>
    <div class="kb-row"><span class="kb-key">F</span><span class="kb-desc">Fullscreen</span></div>
    <div class="kb-row"><span class="kb-key">I</span><span class="kb-desc">Picture in Picture</span></div>
    <div class="kb-row"><span class="kb-key">L</span><span class="kb-desc">Loop toggle</span></div>
    <div class="kb-row"><span class="kb-key">S</span><span class="kb-desc">Cycle speed</span></div>
    <div class="kb-row"><span class="kb-key">C</span><span class="kb-desc">Subtitles</span></div>
    <div class="kb-row"><span class="kb-key">H</span><span class="kb-desc">Chapters</span></div>
    <div class="kb-row"><span class="kb-key">V</span><span class="kb-desc">Visualizer</span></div>
    <div class="kb-row"><span class="kb-key">N / P</span><span class="kb-desc">Next / Prev</span></div>
    <div class="kb-row"><span class="kb-key">O</span><span class="kb-desc">Open file</span></div>
    <div class="kb-row"><span class="kb-key">?</span><span class="kb-desc">This panel</span></div>
  </div>

  <div id="ch-panel" class="panel">
    <div class="panel-title">CHAPTERS <span class="panel-close" onclick="toggleChPanel()">✕</span></div>
    <div class="ch-list" id="ch-list"></div>
    <div class="ch-add-row">
      <input class="ch-inp" id="ch-name-in" placeholder="Chapter name…" maxlength="40">
      <button class="ch-add-btn" onclick="addChapterAtCurrent()">+ At Current</button>
    </div>
    <p class="ch-save-note">Chapters auto-saved per track. <span id="ch-save-status"></span></p>
  </div>

  <div id="sub-panel" class="panel">
    <div class="panel-title">SUBTITLES <span class="panel-close" onclick="toggleSubPanel()">✕</span></div>
    <p class="sub-status" id="sub-status">No subtitles loaded</p>
    <div class="sub-row">
      <label>LOAD .VTT / .SRT</label>
      <button class="sub-file-btn" onclick="document.getElementById('sub-in').click()">Browse…</button>
    </div>
    <div class="sub-toggle">
      <div class="tog" id="sub-tog" onclick="toggleSubVis()"></div>
      <label>Show subtitles</label>
    </div>
  </div>

  <div id="viz-panel" class="panel">
    <div class="panel-title">VISUALIZER <span class="panel-close" onclick="toggleVizPanel()">✕</span></div>
    <p style="font-family:'Barlow Condensed',sans-serif;font-size:.72rem;color:var(--dim);margin-bottom:10px;letter-spacing:.05em;">Active for audio files. Choose style:</p>
    <div class="viz-modes">
      <button class="viz-mode-btn active" onclick="setVizMode('bars',this)">Bars</button>
      <button class="viz-mode-btn" onclick="setVizMode('wave',this)">Wave</button>
      <button class="viz-mode-btn" onclick="setVizMode('circle',this)">Circle</button>
      <button class="viz-mode-btn" onclick="setVizMode('mirror',this)">Mirror</button>
    </div>
  </div>

  <div id="toast"></div>

  <input type="file" id="file-in" accept="video/*,audio/*" multiple style="display:none">
  <input type="file" id="folder-in" webkitdirectory multiple accept="audio/*,video/*" style="display:none">
  <input type="file" id="sub-in" accept=".vtt,.srt" style="display:none">
</div>

<script>
/* ════════════════════════════════════════════
   MUFASA MEDIA PLAYER v3
   ✓ HLS (.m3u8) via hls.js
   ✓ DASH (.mpd) via dash.js
   ✓ Audio visualizer (bars/wave/circle/mirror)
   ✓ Persistent chapters per track
   ✓ Mobile double-tap seek + swipe volume
   ✓ Fullscreen floating controls
   ✓ CORS-safe thumbnail capture
   ✓ Persistent playlist (URL tracks)
   ✓ Admin postMessage API
════════════════════════════════════════════ */

// ── Refs ──
const mv          = document.getElementById('mv');
const player      = document.getElementById('player');
const btnPlay     = document.getElementById('btn-play');
const fsPlay      = document.getElementById('fs-play');
const progWrap    = document.getElementById('prog-wrap');
const progFill    = document.getElementById('prog-fill');
const progBuf     = document.getElementById('prog-buf');
const progThumb   = document.getElementById('prog-thumb');
const progTip     = document.getElementById('prog-tip');
const fsProg      = document.getElementById('fs-prog');
const fsPf        = document.getElementById('fs-pf');
const fsPb        = document.getElementById('fs-pb');
const fsThumb     = document.getElementById('fs-thumb');
const tCur        = document.getElementById('t-cur');
const tDur        = document.getElementById('t-dur');
const fsCur       = document.getElementById('fs-cur');
const fsDur       = document.getElementById('fs-dur');
const volSlider   = document.getElementById('vol-slider');
const volIco      = document.getElementById('vol-ico');
const spinner     = document.getElementById('spinner');
const spinLabel   = document.getElementById('spin-label');
const placeholder = document.getElementById('placeholder');
const ntName      = document.getElementById('nt-name');
const ntType      = document.getElementById('nt-type');
const nowTitle    = document.getElementById('now-title');
const playOverlay = document.getElementById('play-overlay');
const playIcon    = document.getElementById('play-icon');
const toastEl     = document.getElementById('toast');
const plList      = document.getElementById('pl-list');
const plCount     = document.getElementById('pl-count');
const fileIn      = document.getElementById('file-in');
const subIn       = document.getElementById('sub-in');
const loopBtn     = document.getElementById('loop-btn');
const fsLoop      = document.getElementById('fs-loop');
const speedBtn    = document.getElementById('speed-btn');
const fsSpeed     = document.getElementById('fs-speed');
const dropZone    = document.getElementById('drop-zone');
const sfL         = document.getElementById('sf-l');
const sfR         = document.getElementById('sf-r');
const urlIn       = document.getElementById('url-in');
const subDisplay  = document.getElementById('sub-display');
const subStatus   = document.getElementById('sub-status');
const subTog      = document.getElementById('sub-tog');
const chOverlay   = document.getElementById('chapter-overlay');
const chLabel     = document.getElementById('chapter-label');
const vizCanvas   = document.getElementById('viz-canvas');
const swipeVol    = document.getElementById('swipe-vol');
const svFill      = document.getElementById('sv-fill');
const svPct       = document.getElementById('sv-pct');

// ── State ──
let playlist    = [];
let currentIdx  = -1;
let isSeeking   = false;
let toastTimer  = null;
let titleTimer  = null;
let chTimer     = null;
let hlsInstance = null;
let dashInstance= null;
const speeds    = [0.25,0.5,0.75,1,1.25,1.5,1.75,2];
let speedIdx    = 3;
let prevMute    = 1;
let chapters    = [];
let subtitles   = [];
let shuffleMode = false;
let repeatAll   = false;
let subVisible  = true;
let vizMode     = 'bars';
let vizAC       = null;
let vizAnalyser = null;
let vizSrc      = null;
let vizRAF      = null;
let vizRunning  = false;
const STORE_KEY = 'mufasa_pl_v3';
const CH_KEY    = 'mufasa_chapters_v3';

// ── Helpers ──
const fmt = s => { if(!isFinite(s)||s<0)return'0:00'; return Math.floor(s/60)+':'+String(Math.floor(s%60)).padStart(2,'0'); };
function toast(msg,dur=2200){ toastEl.textContent=msg; toastEl.classList.add('show'); clearTimeout(toastTimer); toastTimer=setTimeout(()=>toastEl.classList.remove('show'),dur); }
function showSkip(dir,s){ const el=dir==='left'?sfL:sfR; el.textContent=dir==='left'?`◀◀ ${s}s`:`▶▶ ${s}s`; el.style.opacity='1'; setTimeout(()=>el.style.opacity='0',700); }
function flashPlay(p){ playIcon.textContent=p?'⏸':'▶'; playOverlay.classList.remove('flash'); void playOverlay.offsetWidth; playOverlay.classList.add('flash'); }
function setSpinner(on,label='Loading'){ spinner.classList.toggle('on',on); spinLabel.textContent=label; }

// ── Ambient glow ──
function updateAmbience(playing){
  const a=document.getElementById('ambience');
  a.style.background = playing
    ? 'radial-gradient(ellipse 80% 60% at 20% 85%,rgba(212,148,42,.18) 0%,transparent 70%),radial-gradient(ellipse 60% 45% at 80% 15%,rgba(168,116,31,.14) 0%,transparent 70%)'
    : 'radial-gradient(ellipse 70% 50% at 15% 80%,rgba(212,148,42,.07) 0%,transparent 70%),radial-gradient(ellipse 50% 40% at 85% 20%,rgba(168,116,31,.05) 0%,transparent 70%)';
}

// ════════════════════════════════════════
// PERSISTENT PLAYLIST
// ════════════════════════════════════════
function saveList(){
  try{ const s=playlist.filter(t=>!t.url.startsWith('blob:')); localStorage.setItem(STORE_KEY,JSON.stringify({items:s,idx:currentIdx})); }catch(e){}
}
function loadList(){
  try{
    const raw=localStorage.getItem(STORE_KEY); if(!raw)return;
    const data=JSON.parse(raw);
    if(data.items&&data.items.length){ playlist=data.items; renderPlaylist(); toast(`Restored ${playlist.length} track${playlist.length>1?'s':''}`,3000); }
  }catch(e){}
}

// ════════════════════════════════════════
// PERSISTENT CHAPTERS per track
// ════════════════════════════════════════
function saveChapters(){
  try{
    const all=JSON.parse(localStorage.getItem(CH_KEY)||'{}');
    const key=playlist[currentIdx]?.url||'';
    if(key) all[key]=chapters;
    localStorage.setItem(CH_KEY,JSON.stringify(all));
    document.getElementById('ch-save-status').textContent=`Saved ${chapters.length} chapter${chapters.length!==1?'s':''}`;
  }catch(e){}
}
function loadChapters(url){
  try{
    const all=JSON.parse(localStorage.getItem(CH_KEY)||'{}');
    chapters=all[url]||[];
  }catch(e){ chapters=[]; }
}

// ════════════════════════════════════════
// HLS / DASH / native loader
// ════════════════════════════════════════
function destroyAdaptive(){
  if(hlsInstance){ hlsInstance.destroy(); hlsInstance=null; }
  if(dashInstance){ dashInstance.reset(); dashInstance=null; }
  document.getElementById('hls-badge').classList.remove('show');
}

function loadMedia(url, play=false){
  destroyAdaptive();
  const isHLS  = /\.m3u8/i.test(url);
  const isDASH = /\.mpd/i.test(url);

  if(isHLS && typeof Hls !== 'undefined' && Hls.isSupported()){
    hlsInstance = new Hls({ maxBufferLength:30, enableWorker:true });
    hlsInstance.loadSource(url);
    hlsInstance.attachMedia(mv);
    hlsInstance.on(Hls.Events.MANIFEST_PARSED,()=>{ setSpinner(false); if(play) mv.play().catch(()=>{}); });
    hlsInstance.on(Hls.Events.ERROR,(_,d)=>{ if(d.fatal){ setSpinner(false); toast('HLS error: '+d.type); } });
    document.getElementById('hls-badge').textContent='HLS';
    document.getElementById('hls-badge').classList.add('show');
    spinLabel.textContent='HLS Stream';
  } else if(isDASH && typeof dashjs !== 'undefined'){
    dashInstance = dashjs.MediaPlayer().create();
    dashInstance.initialize(mv, url, play);
    dashInstance.updateSettings({ streaming:{ buffer:{ fastSwitchEnabled:true } } });
    document.getElementById('hls-badge').textContent='DASH';
    document.getElementById('hls-badge').classList.add('show');
  } else {
    mv.src = url;
    mv.load();
    if(play) mv.play().catch(()=>{});
  }
}

// ════════════════════════════════════════
// THUMBNAIL — CORS-safe
// ════════════════════════════════════════
function captureThumbnail(idx){
  const t=playlist[idx];
  if(!t||t.thumb||!t.url) return;
  const v=document.createElement('video');
  v.crossOrigin='anonymous';
  v.preload='metadata'; v.muted=true; v.src=t.url;
  v.addEventListener('loadedmetadata',()=>{ v.currentTime=Math.min(4,v.duration*0.08); });
  v.addEventListener('seeked',()=>{
    try{
      const c=document.createElement('canvas'); c.width=96; c.height=54;
      c.getContext('2d').drawImage(v,0,0,96,54);
      t.thumb=c.toDataURL('image/jpeg',0.7);
      t.duration=v.duration; v.remove(); renderPlaylist();
    }catch(e){
      // CORS blocked — use a coloured placeholder instead of crashing
      t.thumb=null; t.thumbFail=true; v.remove();
    }
  },{once:true});
  v.addEventListener('error',()=>{ t.thumbFail=true; v.remove(); });
  document.body.appendChild(v);
}

// ════════════════════════════════════════
// PLAYLIST
// ════════════════════════════════════════
function addToPlaylist(items){
  const start=playlist.length;
  items.forEach(it=>playlist.push(it));
  renderPlaylist();
  items.forEach((_,i)=>setTimeout(()=>captureThumbnail(start+i),200+i*250));
  if(currentIdx===-1) loadTrack(0);
  saveList();
}
function removeFromPlaylist(idx){
  if(idx===currentIdx){ destroyAdaptive(); mv.pause(); mv.src=''; currentIdx=-1; placeholder.classList.remove('hidden'); stopViz(); }
  else if(idx<currentIdx) currentIdx--;
  if(playlist[idx]?.url?.startsWith('blob:')) URL.revokeObjectURL(playlist[idx].url);
  playlist.splice(idx,1); renderPlaylist(); saveList();
}
function clearPlaylist(){
  destroyAdaptive();
  playlist.forEach(t=>{ if(t.url?.startsWith('blob:')) URL.revokeObjectURL(t.url); });
  playlist=[]; currentIdx=-1; mv.pause(); mv.src='';
  placeholder.classList.remove('hidden');
  renderPlaylist(); saveList(); stopViz(); toast('Playlist cleared');
}
function renderPlaylist(){
  plList.innerHTML='';
  plCount.textContent=`${playlist.length} ITEM${playlist.length!==1?'S':''}`;
  playlist.forEach((item,i)=>{
    const isActive=i===currentIdx;
    const div=document.createElement('div');
    div.className='pl-item'+(isActive?' active':'');
    const thumbHTML = item.thumb
      ? `<img src="${item.thumb}" alt="">`
      : (item.type==='audio'?'♪':item.thumbFail?'🚫':'▶');
    div.innerHTML=`
      <div class="pl-idx">
        <div class="pl-bars" style="display:${isActive?'flex':'none'}">
          <div class="pl-bar"></div><div class="pl-bar"></div><div class="pl-bar"></div>
        </div>
        <span class="pl-num-txt" style="visibility:${isActive?'hidden':'visible'}">${i+1}</span>
      </div>
      <div class="pl-thumb">${thumbHTML}${item.duration?`<span class="pl-thumb-dur">${fmt(item.duration)}</span>`:''}</div>
      <div class="pl-info">
        <div class="pl-name">${item.name}</div>
        <div class="pl-meta">${item.streamType||item.type?.toUpperCase()||'VIDEO'}${item.url?.startsWith('http')?' · STREAM':''}</div>
      </div>
      <span class="pl-dur">${item.duration?fmt(item.duration):'—'}</span>
      <button class="pl-rm" onclick="event.stopPropagation();removeFromPlaylist(${i})">✕</button>`;
    div.addEventListener('click',()=>loadTrack(i,true));
    plList.appendChild(div);
  });
  const ae=plList.querySelector('.pl-item.active');
  if(ae) ae.scrollIntoView({block:'nearest',behavior:'smooth'});
}

function loadTrack(idx,play=false){
  if(idx<0||idx>=playlist.length) return;
  currentIdx=idx;
  const t=playlist[idx];
  placeholder.classList.add('hidden');
  ntName.textContent=t.name;
  ntType.textContent=t.streamType||t.type?.toUpperCase()||'';
  showNowTitle();
  loadChapters(t.url);
  renderChList(); clearChDots();
  subtitles=[]; subDisplay.innerHTML='';
  setSpinner(true, t.streamType||'Loading');
  loadMedia(t.url, play);
  renderPlaylist();
  saveList();
  postUp({type:'trackChanged',idx,name:t.name,url:t.url});
}

function showNowTitle(){
  nowTitle.classList.add('show');
  clearTimeout(titleTimer);
  titleTimer=setTimeout(()=>nowTitle.classList.remove('show'),4500);
}

// ════════════════════════════════════════
// AUDIO VISUALIZER
// ════════════════════════════════════════
function initViz(){
  if(vizAC) return;
  try{
    vizAC = new (window.AudioContext||window.webkitAudioContext)();
    vizAnalyser = vizAC.createAnalyser();
    vizAnalyser.fftSize = 256;
    vizAnalyser.smoothingTimeConstant = 0.8;
    vizSrc = vizAC.createMediaElementSource(mv);
    vizSrc.connect(vizAnalyser);
    vizAnalyser.connect(vizAC.destination);
  }catch(e){ vizAC=null; }
}

function startViz(){
  if(!vizAC||vizRunning) return;
  vizRunning=true;
  drawViz();
}
function stopViz(){
  vizRunning=false;
  if(vizRAF){ cancelAnimationFrame(vizRAF); vizRAF=null; }
  const ctx=vizCanvas.getContext('2d');
  ctx.clearRect(0,0,vizCanvas.width,vizCanvas.height);
}
function setVizMode(mode,btn){
  vizMode=mode;
  document.querySelectorAll('.viz-mode-btn').forEach(b=>b.classList.remove('active'));
  btn.classList.add('active');
}

function drawViz(){
  if(!vizRunning){ return; }
  vizRAF=requestAnimationFrame(drawViz);
  const c=vizCanvas, ctx=c.getContext('2d');
  c.width=c.offsetWidth; c.height=c.offsetHeight;
  const W=c.width, H=c.height;
  const data=new Uint8Array(vizAnalyser.frequencyBinCount);
  if(vizMode==='wave') vizAnalyser.getByteTimeDomainData(data);
  else vizAnalyser.getByteFrequencyData(data);
  ctx.clearRect(0,0,W,H);
  // dark bg gradient
  const bg=ctx.createLinearGradient(0,0,0,H);
  bg.addColorStop(0,'#050403'); bg.addColorStop(1,'#0C0A08');
  ctx.fillStyle=bg; ctx.fillRect(0,0,W,H);

  const gold='#D4942A', goldL='#F0B84A', goldD='#A8741F';

  if(vizMode==='bars'||vizMode==='mirror'){
    const n=data.length, bw=W/n*1.6, gap=1;
    for(let i=0;i<n;i++){
      const v=data[i]/255;
      const bh=v*H*0.85;
      const x=i*(bw+gap);
      const g=ctx.createLinearGradient(0,H,0,H-bh);
      g.addColorStop(0,goldD); g.addColorStop(0.5,gold); g.addColorStop(1,goldL);
      ctx.fillStyle=g; ctx.beginPath();
      ctx.roundRect?ctx.roundRect(x,H-bh,bw,bh,2):ctx.rect(x,H-bh,bw,bh);
      ctx.fill();
      if(vizMode==='mirror'){
        ctx.globalAlpha=0.3;
        ctx.beginPath();
        ctx.roundRect?ctx.roundRect(x,0,bw,bh,2):ctx.rect(x,0,bw,bh);
        ctx.fill(); ctx.globalAlpha=1;
      }
    }
  } else if(vizMode==='wave'){
    ctx.beginPath(); ctx.strokeStyle=gold; ctx.lineWidth=2;
    const sl=W/data.length;
    data.forEach((v,i)=>{ const y=v/255*H; i===0?ctx.moveTo(0,y):ctx.lineTo(i*sl,y); });
    ctx.stroke();
    // glow
    ctx.shadowColor=gold; ctx.shadowBlur=12;
    ctx.beginPath(); ctx.strokeStyle=goldL; ctx.lineWidth=1;
    data.forEach((v,i)=>{ const y=v/255*H; i===0?ctx.moveTo(0,y):ctx.lineTo(i*sl,y); });
    ctx.stroke(); ctx.shadowBlur=0;
  } else if(vizMode==='circle'){
    const cx=W/2, cy=H/2, r=Math.min(W,H)*0.22;
    const n=data.length;
    ctx.strokeStyle=gold; ctx.lineWidth=2;
    for(let i=0;i<n;i++){
      const angle=(i/n)*Math.PI*2;
      const v=data[i]/255;
      const r1=r, r2=r+v*r*1.6;
      const x1=cx+Math.cos(angle)*r1, y1=cy+Math.sin(angle)*r1;
      const x2=cx+Math.cos(angle)*r2, y2=cy+Math.sin(angle)*r2;
      const g=ctx.createLinearGradient(x1,y1,x2,y2);
      g.addColorStop(0,goldD); g.addColorStop(1,goldL);
      ctx.beginPath(); ctx.strokeStyle=g; ctx.moveTo(x1,y1); ctx.lineTo(x2,y2); ctx.stroke();
    }
    // centre circle
    ctx.beginPath(); ctx.arc(cx,cy,r*0.35,0,Math.PI*2);
    ctx.fillStyle='rgba(212,148,42,.15)'; ctx.fill();
    ctx.strokeStyle=gold; ctx.lineWidth=1.5; ctx.stroke();
    // lion text
    ctx.fillStyle=gold; ctx.font=`bold ${Math.round(r*0.4)}px Anton,sans-serif`;
    ctx.textAlign='center'; ctx.textBaseline='middle';
    ctx.fillText('🦁',cx,cy);
  }
}

function enterAudioMode(){
  player.classList.add('audio-mode');
  initViz();
  if(vizAC&&vizAC.state==='suspended') vizAC.resume();
  startViz();
}
function exitAudioMode(){
  player.classList.remove('audio-mode');
  stopViz();
}

// ════════════════════════════════════════
// TRANSPORT
// ════════════════════════════════════════
function togglePlay(){
  if(!mv.src&&!hlsInstance&&!dashInstance){ fileIn.click(); return; }
  if(mv.paused) mv.play().catch(()=>toast('Tap video first'));
  else mv.pause();
}
function skipTime(s){
  mv.currentTime=Math.max(0,Math.min(mv.duration||0,mv.currentTime+s));
  showSkip(s<0?'left':'right',Math.abs(s));
  postUp({type:'seek',time:mv.currentTime});
}
function skipTrack(dir){
  if(!playlist.length) return;
  if(shuffleMode && playlist.length>1){
    let next;
    do { next=Math.floor(Math.random()*playlist.length); } while(next===currentIdx && playlist.length>1);
    loadTrack(next,true);
  } else {
    const n=currentIdx+dir;
    if(n>=0&&n<playlist.length) loadTrack(n,true);
    else if(repeatAll) loadTrack(dir>0?0:playlist.length-1,true);
    else toast(dir>0?'⏹ End of playlist':'⏮ Start of playlist');
  }
}
function toggleRepeatAll(){
  repeatAll=!repeatAll;
  document.getElementById('repeat-btn').classList.toggle('active',repeatAll);
  toast(repeatAll?'🔂 Repeat playlist ON':'🔂 Repeat playlist OFF');
}
function toggleShuffle(){
  shuffleMode=!shuffleMode;
  document.getElementById('shuffle-btn').classList.toggle('active',shuffleMode);
  toast(shuffleMode?'🔀 Shuffle ON':'🔀 Shuffle OFF');
}
function saveNamedPlaylist(){
  if(!playlist.length){ toast('Playlist is empty'); return; }
  const name=prompt('Name this playlist:','My Playlist');
  if(!name) return;
  const saved=JSON.parse(localStorage.getItem('muf_saved_playlists')||'{}');
  saved[name]=playlist.filter(t=>!t.url.startsWith('blob:')).map(t=>({name:t.name,url:t.url,type:t.type,streamType:t.streamType}));
  localStorage.setItem('muf_saved_playlists',JSON.stringify(saved));
  toast(`💾 Saved "${name}" (${saved[name].length} tracks)`);
}
function loadNamedPlaylist(){
  const saved=JSON.parse(localStorage.getItem('muf_saved_playlists')||'{}');
  const names=Object.keys(saved);
  if(!names.length){ toast('No saved playlists'); return; }
  const name=prompt('Load playlist:\n'+names.map((n,i)=>`${i+1}. ${n}`).join('\n')+'\n\nType name or number:');
  if(!name) return;
  const key=names[parseInt(name)-1]||name;
  if(!saved[key]){ toast('Playlist not found'); return; }
  playlist=[]; currentIdx=-1; mv.pause(); mv.src=''; renderPlaylist();
  addToPlaylist(saved[key]);
  toast(`📂 Loaded "${key}"`);
}
function toggleLoop(){ mv.loop=!mv.loop; loopBtn.classList.toggle('active',mv.loop); fsLoop.classList.toggle('active',mv.loop); toast(mv.loop?'Loop ON':'Loop OFF'); }
function cycleSpeed(){
  speedIdx=(speedIdx+1)%speeds.length;
  mv.playbackRate=speeds[speedIdx];
  speedBtn.textContent=speeds[speedIdx]+'×';
  fsSpeed.textContent=speeds[speedIdx]+'×';
  toast('Speed: '+speeds[speedIdx]+'×');
}
function toggleMute(){ if(mv.volume>0){prevMute=mv.volume;mv.volume=0;volSlider.value=0;}else{mv.volume=prevMute||1;volSlider.value=mv.volume;} updateVolIco(); }
function updateVolIco(){ volIco.textContent=mv.volume===0?'🔇':mv.volume<0.4?'🔈':mv.volume<0.75?'🔉':'🔊'; }
async function togglePiP(){
  try{ if(document.pictureInPictureElement) await document.exitPictureInPicture(); else{ if(!mv.src)return toast('Load video first'); await mv.requestPictureInPicture(); } }
  catch(e){ toast('PiP not supported here'); }
}
function toggleFullscreen(){ if(!document.fullscreenElement) player.requestFullscreen?.(); else document.exitFullscreen?.(); }
function toggleKbs(){ document.getElementById('kbs').classList.toggle('show'); }
function toggleChPanel(){ document.getElementById('ch-panel').classList.toggle('show'); renderChList(); }
function toggleSubPanel(){ document.getElementById('sub-panel').classList.toggle('show'); }
function toggleVizPanel(){ document.getElementById('viz-panel').classList.toggle('show'); }

// ════════════════════════════════════════
// URL LOADING — detects HLS / DASH
// ════════════════════════════════════════
function loadFromURL(){
  const url=urlIn.value.trim();
  if(!url){ toast('Paste a URL first'); return; }
  if(!url.startsWith('http')){ toast('URL must start with http://'); return; }
  const isHLS=/\.m3u8/i.test(url), isDASH=/\.mpd/i.test(url);
  const isAudio=/\.(mp3|wav|ogg|aac|flac|m4a)/i.test(url);
  const rawName=url.split('/').pop().replace(/\?.*$/,'').replace(/\.[^.]+$/,'')||'Stream';
  const name=decodeURIComponent(rawName).slice(0,60);
  const streamType=isHLS?'HLS':isDASH?'DASH':isAudio?'AUDIO':'VIDEO';
  const type=isAudio?'audio':'video';
  addToPlaylist([{name,url,type,streamType}]);
  urlIn.value=''; toast(`Added: ${name} [${streamType}]`);
}
urlIn.addEventListener('keydown',e=>{ if(e.key==='Enter') loadFromURL(); });

// ════════════════════════════════════════
// CHAPTERS — persistent
// ════════════════════════════════════════
function addChapterAtCurrent(){
  const ni=document.getElementById('ch-name-in');
  const name=ni.value.trim()||`Chapter ${chapters.length+1}`;
  chapters.push({time:mv.currentTime||0,label:name});
  chapters.sort((a,b)=>a.time-b.time);
  ni.value=''; renderChList(); renderChDots(); saveChapters(); toast('Chapter: '+name);
}
function deleteChapter(idx){ chapters.splice(idx,1); renderChList(); renderChDots(); saveChapters(); }
function seekToChapter(idx){ mv.currentTime=chapters[idx].time; toast('→ '+chapters[idx].label); }
function renderChList(){
  const el=document.getElementById('ch-list');
  if(!chapters.length){ el.innerHTML='<p style="font-family:\'Barlow Condensed\',sans-serif;font-size:.72rem;color:var(--dim);padding:4px 0">Play a video then tap + At Current.</p>'; return; }
  el.innerHTML=chapters.map((c,i)=>`<div class="ch-entry"><span class="ch-time" onclick="seekToChapter(${i})">${fmt(c.time)}</span><span class="ch-lbl">${c.label}</span><button class="ch-del" onclick="deleteChapter(${i})">✕</button></div>`).join('');
}
function clearChDots(){ progWrap.querySelectorAll('.ch-dot').forEach(d=>d.remove()); }
function renderChDots(){
  clearChDots();
  if(!mv.duration) return;
  chapters.forEach((c,i)=>{
    const dot=document.createElement('div'); dot.className='ch-dot';
    dot.style.left=(c.time/mv.duration*100)+'%';
    dot.innerHTML=`<span class="ch-dot-tip">${c.label}</span>`;
    dot.addEventListener('click',e=>{ e.stopPropagation(); seekToChapter(i); });
    progWrap.appendChild(dot);
  });
}
function checkChapter(){
  if(!chapters.length) return;
  let cur=null;
  for(let i=chapters.length-1;i>=0;i--){ if(mv.currentTime>=chapters[i].time){ cur=chapters[i]; break; } }
  if(cur){ chLabel.textContent=cur.label; chOverlay.classList.add('show'); clearTimeout(chTimer); chTimer=setTimeout(()=>chOverlay.classList.remove('show'),2400); }
}

// ════════════════════════════════════════
// SUBTITLES
// ════════════════════════════════════════
function parseVTT(text){
  const cues=[];
  text.split(/\n\n+/).forEach(block=>{
    const lines=block.trim().split('\n');
    let ti=lines.findIndex(l=>/-->/.test(l)); if(ti<0) return;
    const [ss,es]=lines[ti].split('-->').map(s=>s.trim().split(' ')[0]);
    const pt=s=>{ const p=s.split(':'); return p.length===3?(+p[0])*3600+(+p[1])*60+parseFloat(p[2].replace(',','.')):(+p[0])*60+parseFloat(p[1].replace(',','.')); };
    const txt=lines.slice(ti+1).join('\n').trim().replace(/<[^>]+>/g,'');
    if(txt) cues.push({start:pt(ss),end:pt(es),text:txt});
  });
  return cues;
}
subIn.addEventListener('change',e=>{
  const f=e.target.files[0]; if(!f) return;
  const r=new FileReader();
  r.onload=ev=>{ subtitles=parseVTT(ev.target.result); subStatus.innerHTML=`Loaded: <span>${f.name}</span> — ${subtitles.length} cues`; subTog.classList.add('on'); subVisible=true; toast(`Subtitles: ${subtitles.length} cues`); };
  r.readAsText(f); subIn.value='';
});
function toggleSubVis(){ subVisible=!subVisible; subTog.classList.toggle('on',subVisible); subDisplay.style.display=subVisible?'':'none'; toast(subVisible?'Subtitles ON':'Subtitles OFF'); }
function renderSub(){
  if(!subVisible||!subtitles.length){ subDisplay.innerHTML=''; return; }
  const t=mv.currentTime;
  const cue=subtitles.find(c=>t>=c.start&&t<=c.end);
  subDisplay.innerHTML=cue?cue.text.split('\n').map(l=>`<div class="sub-line">${l}</div>`).join(''):'';
}

// ════════════════════════════════════════
// PROGRESS BAR (normal + fullscreen)
// ════════════════════════════════════════
function pctFromEvent(e,wrap){
  const r=wrap.getBoundingClientRect();
  return Math.max(0,Math.min(1,(e.clientX-r.left)/r.width));
}
let fsSeeking=false;
progWrap.addEventListener('mousedown',e=>{ isSeeking=true; progWrap.classList.add('dragging'); if(isFinite(mv.duration)) mv.currentTime=pctFromEvent(e,progWrap)*mv.duration; });
fsProg.addEventListener('mousedown',e=>{ fsSeeking=true; if(isFinite(mv.duration)) mv.currentTime=pctFromEvent(e,fsProg)*mv.duration; });
document.addEventListener('mousemove',e=>{
  if(isSeeking&&isFinite(mv.duration)) mv.currentTime=pctFromEvent(e,progWrap)*mv.duration;
  if(fsSeeking&&isFinite(mv.duration)) mv.currentTime=pctFromEvent(e,fsProg)*mv.duration;
  if(progWrap.matches(':hover')){
    const pct=pctFromEvent(e,progWrap);
    progTip.textContent=fmt(pct*(mv.duration||0));
    progTip.style.left=(pct*100)+'%';
    progThumb.style.left=(pct*100)+'%';
  }
});
document.addEventListener('mouseup',()=>{ isSeeking=false; fsSeeking=false; progWrap.classList.remove('dragging'); });
progWrap.addEventListener('touchstart',e=>{ isSeeking=true; if(isFinite(mv.duration)) mv.currentTime=pctFromEvent(e.touches[0],progWrap)*mv.duration; },{passive:true});
document.addEventListener('touchmove',e=>{ if(isSeeking&&isFinite(mv.duration)) mv.currentTime=pctFromEvent(e.touches[0],progWrap)*mv.duration; },{passive:true});
document.addEventListener('touchend',()=>{ isSeeking=false; });

function updateProgress(){
  const pct=mv.duration?mv.currentTime/mv.duration:0;
  const w=(pct*100)+'%';
  progFill.style.width=w; progThumb.style.left=w;
  fsPf.style.width=w; fsThumb.style.left=w;
  tCur.textContent=fmt(mv.currentTime); tDur.textContent=fmt(mv.duration);
  fsCur.textContent=fmt(mv.currentTime); fsDur.textContent=fmt(mv.duration);
}

// ════════════════════════════════════════
// MOBILE TOUCH — double-tap seek + swipe volume
// ════════════════════════════════════════
let lastTap={left:0,right:0};
let swipeStart=null, swipeVolStart=null, swipeActive=false;

function setupMobileTouch(){
  const vidWrap=document.getElementById('vid-wrap');
  const tL=document.getElementById('touch-left');
  const tR=document.getElementById('touch-right');

  // Double-tap seek on left/right zones
  [tL,tR].forEach(zone=>{
    zone.addEventListener('touchend',e=>{
      e.preventDefault();
      const dir=zone===tL?'left':'right';
      const now=Date.now();
      if(now-lastTap[dir]<350){
        skipTime(dir==='left'?-10:10);
        lastTap[dir]=0;
      } else {
        lastTap[dir]=now;
        // single tap = toggle play
        setTimeout(()=>{ if(lastTap[dir]!==0){ togglePlay(); lastTap[dir]=0; } },360);
      }
    },{passive:false});
  });

  // Swipe up/down on right side = volume
  vidWrap.addEventListener('touchstart',e=>{
    const t=e.touches[0];
    const vw=vidWrap.getBoundingClientRect();
    if(t.clientX>vw.left+vw.width*0.65){
      swipeStart={y:t.clientY}; swipeVolStart=mv.volume; swipeActive=true;
      swipeVol.classList.add('show'); updateSwipeVol();
    }
  },{passive:true});
  vidWrap.addEventListener('touchmove',e=>{
    if(!swipeActive||!swipeStart) return;
    const dy=swipeStart.y-e.touches[0].clientY;
    const vw=document.getElementById('vid-wrap').getBoundingClientRect();
    const delta=dy/vw.height;
    mv.volume=Math.max(0,Math.min(1,swipeVolStart+delta));
    volSlider.value=mv.volume; updateVolIco(); updateSwipeVol();
  },{passive:true});
  vidWrap.addEventListener('touchend',()=>{
    swipeActive=false; swipeStart=null;
    setTimeout(()=>swipeVol.classList.remove('show'),800);
  },{passive:true});
}
function updateSwipeVol(){
  const pct=Math.round(mv.volume*100);
  svFill.style.height=pct+'%'; svPct.textContent=pct+'%';
}

// ════════════════════════════════════════
// VIDEO EVENTS
// ════════════════════════════════════════
mv.addEventListener('timeupdate',()=>{
  if(isSeeking||fsSeeking) return;
  updateProgress(); renderSub();
  postUp({type:'timeupdate',time:mv.currentTime,duration:mv.duration});
});
mv.addEventListener('progress',()=>{
  if(!mv.duration) return;
  try{ const b=mv.buffered; if(b.length){ const w=(b.end(b.length-1)/mv.duration*100)+'%'; progBuf.style.width=w; fsPb.style.width=w; } }catch(e){}
});
mv.addEventListener('play',()=>{
  btnPlay.textContent='⏸'; fsPlay.textContent='⏸';
  player.classList.add('playing'); updateAmbience(true);
  renderPlaylist(); flashPlay(true);
  if(vizAC&&player.classList.contains('audio-mode')) startViz();
  postUp({type:'play',idx:currentIdx});
});
mv.addEventListener('pause',()=>{
  btnPlay.textContent='▶'; fsPlay.textContent='▶';
  player.classList.remove('playing'); updateAmbience(false);
  renderPlaylist(); flashPlay(false);
  postUp({type:'pause',time:mv.currentTime});
});
mv.addEventListener('ended',()=>{
  if(mv.loop) return;
  if(shuffleMode && playlist.length > 1){
    let next;
    do { next = Math.floor(Math.random()*playlist.length); } while(next===currentIdx && playlist.length>1);
    loadTrack(next,true);
  } else if(currentIdx < playlist.length-1){
    loadTrack(currentIdx+1,true);
  } else if(repeatAll && playlist.length){
    loadTrack(0,true); toast('🔂 Restarting playlist');
  } else {
    toast('⏹ End of playlist');
  }
});
mv.addEventListener('waiting',()=>setSpinner(true,'Buffering'));
mv.addEventListener('canplay',()=>setSpinner(false));
mv.addEventListener('playing',()=>setSpinner(false));
mv.addEventListener('loadedmetadata',()=>{
  setSpinner(false);
  tDur.textContent=fmt(mv.duration); fsDur.textContent=fmt(mv.duration);
  const q=document.getElementById('qual-btn');
  if(mv.videoHeight>=2160) q.textContent='4K';
  else if(mv.videoHeight>=1080) q.textContent='1080P';
  else if(mv.videoHeight>=720)  q.textContent='720P';
  else if(mv.videoHeight>=480)  q.textContent='480P';
  else if(mv.videoHeight>0)     q.textContent=mv.videoHeight+'P';
  else q.textContent='AUDIO';
  // Audio-only mode
  if(mv.videoHeight===0){ enterAudioMode(); } else { exitAudioMode(); }
  renderChDots();
  if(currentIdx>=0){ playlist[currentIdx].duration=mv.duration; renderPlaylist(); saveList(); }
});
mv.addEventListener('error',()=>{ setSpinner(false); toast('⚠ Could not load media'); });
mv.addEventListener('seeked',checkChapter);
mv.addEventListener('enterpictureinpicture',()=>{ document.getElementById('pip-badge').classList.add('show'); toast('📺 PiP active'); });
mv.addEventListener('leavepictureinpicture',()=>document.getElementById('pip-badge').classList.remove('show'));
document.getElementById('vid-wrap').addEventListener('click',e=>{
  if(e.target===document.getElementById('vid-wrap')||e.target===mv||e.target===vizCanvas) togglePlay();
});
volSlider.addEventListener('input',()=>{ mv.volume=parseFloat(volSlider.value); updateVolIco(); });

// ════════════════════════════════════════
// FILE LOADING
// ════════════════════════════════════════
fileIn.addEventListener('change',e=>{
  const items=Array.from(e.target.files).map(f=>({ name:f.name.replace(/\.[^.]+$/,''), url:URL.createObjectURL(f), type:f.type.startsWith('audio')?'audio':'video' }));
  if(items.length) addToPlaylist(items);
  fileIn.value='';
});

// Folder picker — sort by name for a natural playlist order
document.getElementById('folder-in').addEventListener('change',e=>{
  const files=Array.from(e.target.files)
    .filter(f=>f.type.startsWith('audio')||f.type.startsWith('video'))
    .sort((a,b)=>a.name.localeCompare(b.name,undefined,{numeric:true}));
  if(!files.length){ toast('No media files found in folder'); return; }
  const items=files.map(f=>({ name:f.name.replace(/\.[^.]+$/,''), url:URL.createObjectURL(f), type:f.type.startsWith('audio')?'audio':'video' }));
  addToPlaylist(items);
  toast(`📂 Added ${items.length} files from folder`);
  document.getElementById('folder-in').value='';
});

// ════════════════════════════════════════
// DRAG & DROP (files + URL drops)
// ════════════════════════════════════════
document.addEventListener('dragenter',e=>{ e.preventDefault(); dropZone.classList.add('over'); });
document.addEventListener('dragleave',e=>{ if(!e.relatedTarget) dropZone.classList.remove('over'); });
document.addEventListener('dragover', e=>{ e.preventDefault(); });
document.addEventListener('drop',e=>{
  e.preventDefault(); dropZone.classList.remove('over');
  const urlData=e.dataTransfer.getData('text/uri-list')||e.dataTransfer.getData('text/plain');
  if(urlData&&urlData.startsWith('http')&&!e.dataTransfer.files.length){
    urlIn.value=urlData; loadFromURL(); return;
  }
  const items=Array.from(e.dataTransfer.files).filter(f=>f.type.startsWith('video')||f.type.startsWith('audio'))
    .map(f=>({ name:f.name.replace(/\.[^.]+$/,''), url:URL.createObjectURL(f), type:f.type.startsWith('audio')?'audio':'video' }));
  if(items.length) addToPlaylist(items);
});

// ════════════════════════════════════════
// KEYBOARD
// ════════════════════════════════════════
document.addEventListener('keydown',e=>{
  if(e.target.tagName==='INPUT'||e.target.tagName==='TEXTAREA') return;
  switch(e.code){
    case 'Space':     e.preventDefault(); togglePlay(); break;
    case 'ArrowLeft': e.preventDefault(); skipTime(-10); break;
    case 'ArrowRight':e.preventDefault(); skipTime(10); break;
    case 'ArrowUp':   e.preventDefault(); mv.volume=Math.min(1,mv.volume+0.1); volSlider.value=mv.volume; updateVolIco(); toast('Vol '+Math.round(mv.volume*100)+'%'); break;
    case 'ArrowDown': e.preventDefault(); mv.volume=Math.max(0,mv.volume-0.1); volSlider.value=mv.volume; updateVolIco(); toast('Vol '+Math.round(mv.volume*100)+'%'); break;
    case 'KeyM': toggleMute(); break;
    case 'KeyF': toggleFullscreen(); break;
    case 'KeyI': togglePiP(); break;
    case 'KeyL': toggleLoop(); break;
    case 'KeyS': cycleSpeed(); break;
    case 'KeyN': skipTrack(1); break;
    case 'KeyP': skipTrack(-1); break;
    case 'KeyO': fileIn.click(); break;
    case 'KeyC': toggleSubPanel(); break;
    case 'KeyH': toggleChPanel(); break;
    case 'KeyV': toggleVizPanel(); break;
    case 'KeyR': toggleRepeatAll(); break;
    case 'KeyZ': toggleShuffle(); break;
    case 'Slash': if(e.shiftKey) toggleKbs(); break;
  }
});

// ════════════════════════════════════════
// ADMIN postMessage API
// ════════════════════════════════════════
window.addEventListener('message',e=>{
  const d=e.data; if(!d||!d.type) return;
  switch(d.type){
    case 'load': addToPlaylist([{name:d.name||'Admin Track',url:d.url,type:d.mediaType||'video',streamType:d.streamType}]); document.getElementById('admin-badge').classList.add('show'); toast('⚡ Admin: '+( d.name||'track loaded')); break;
    case 'play':   mv.play(); break;
    case 'pause':  mv.pause(); break;
    case 'seek':   if(isFinite(d.time)) mv.currentTime=d.time; break;
    case 'volume': if(isFinite(d.value)){ mv.volume=Math.max(0,Math.min(1,d.value)); volSlider.value=mv.volume; updateVolIco(); } break;
    case 'next':   skipTrack(1); break;
    case 'prev':   skipTrack(-1); break;
    case 'addPlaylist': if(Array.isArray(d.items)){ addToPlaylist(d.items); document.getElementById('admin-badge').classList.add('show'); } break;
    case 'getState': postUp({type:'state',playing:!mv.paused,time:mv.currentTime,duration:mv.duration,idx:currentIdx,playlist:playlist.map(t=>({name:t.name,url:t.url,type:t.type}))}); break;
  }
});
function postUp(data){ try{ window.parent.postMessage({source:'MufasaPlayer',...data},'*'); }catch(e){} }

// ════════════════════════════════════════
// DEMO
// ════════════════════════════════════════
const DEMO=[
  {name:'Big Buck Bunny',      url:'https://commondatastorage.googleapis.com/gtv-videos-bucket/sample/BigBuckBunny.mp4',               type:'video'},
  {name:'Elephant Dream',      url:'https://commondatastorage.googleapis.com/gtv-videos-bucket/sample/ElephantsDream.mp4',             type:'video'},
  {name:'For Bigger Blazes',   url:'https://commondatastorage.googleapis.com/gtv-videos-bucket/sample/ForBiggerBlazes.mp4',            type:'video'},
  {name:'Subaru Outback',      url:'https://commondatastorage.googleapis.com/gtv-videos-bucket/sample/SubaruOutbackOnStreetAndDirt.mp4',type:'video'},
  // Public HLS test stream
  {name:'HLS Test Stream',     url:'https://test-streams.mux.dev/x36xhzz/x36xhzz.m3u8', type:'video', streamType:'HLS'},
];
function loadDemo(){ playlist=[]; currentIdx=-1; addToPlaylist(DEMO); loadTrack(0,true); toast('Demo loaded — 4 MP4 + 1 HLS stream'); }

// ════════════════════════════════════════
// INIT
// ════════════════════════════════════════
function sortPlaylist(){
  if(!playlist.length){ toast('Playlist is empty'); return; }
  const active = playlist[currentIdx];
  playlist.sort((a,b)=>a.name.localeCompare(b.name,undefined,{numeric:true}));
  if(active) currentIdx=playlist.indexOf(active);
  renderPlaylist(); saveList();
  toast('🔤 Sorted A–Z');
}

setupMobileTouch();
renderPlaylist();
renderChList();
loadList();
updateAmbience(false);
toast('v3 · HLS/DASH · Shuffle (Z) · Repeat (R) · Folder (📂) · ? for shortcuts',4500);
window.MufasaPlayer={togglePlay,skipTime,skipTrack,loadDemo,addToPlaylist,loadFromURL,togglePiP,addChapterAtCurrent,postUp,setVizMode};
</script>
</body>
</html>
