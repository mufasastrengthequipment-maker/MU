      <div class="ds-divider"></div>
      <div class="ds-item"><span class="ds-ic">💬</span><div class="ds-txt"><strong>WhatsApp Checkout</strong><span>Order via 0115 228 712</span></div></div>
      <div class="ds-divider"></div>
      <div class="ds-item"><span class="ds-ic">🇰🇪</span><div class="ds-txt"><strong>Nationwide Delivery</strong><span>All 47 counties</span></div></div>
      <div class="ds-divider"></div>
      <div class="ds-item"><span class="ds-ic">✅</span><div class="ds-txt"><strong>Genuine Rubber Hex</strong><span>Quality guaranteed</span></div></div>
    </div>

    <!-- BUNDLES -->
    <section class="sec-anchor" id="bundles">
