<!-- ══ FLOATING BUTTONS ══ -->
<a class="wa-float" href="https://wa.me/254115228712?text=Hello%20MUFASA!%20I%20want%20to%20place%20an%20order." target="_blank" title="WhatsApp">💬</a>

<script>
// ══════════════════════════════════════════
// DATA
// ══════════════════════════════════════════
const WTS = [2,4,6,8,10,12,15,20,25,30,35];
let PRICES = {
  p2:950,p4:1750,p6:2350,p8:2950,p10:3550,p12:4350,p15:5150,p20:6550,p25:7950,p30:9550,p35:10950,
  s2:499,s4:899,s6:1199,s8:1499,s10:1799,s12:2199,s15:2599,s20:3299,s25:3999,s30:4799,s35:5499
};
const ACCS = [
  {id:'bands',name:'Resistance Bands Set',desc:'5 resistance levels, heavy-duty latex',def:1200,icon:'🔴',img:'acc-bands.jpg'},
  {id:'rope',name:'Speed Skipping Rope',desc:'Adjustable steel cable, ball bearings',def:450,icon:'🪢',img:'acc-rope.jpg'},
  {id:'gloves',name:'Gym Gloves (Pair)',desc:'Anti-slip, padded palm protection',def:850,icon:'🥊',img:'acc-gloves.jpg'},
  {id:'mat',name:'Exercise Mat',desc:'10mm thick, non-slip, foldable',def:2500,icon:'🟩',img:'acc-mat.jpg'},
  {id:'pullup',name:'Pull-Up Bar',desc:'Doorframe mount, 120kg capacity',def:3500,icon:'🔩',img:'acc-pullup.jpg'},
  {id:'bench',name:'Adjustable Bench',desc:'6-angle incline, steel frame',def:15000,icon:'🪑',img:'acc-bench.jpg'},
  {id:'rack',name:'Dumbbell Rack (3-Tier)',desc:'Fits up to 6 pairs, steel',def:8500,icon:'🗄️',img:'acc-rack.jpg'},
  {id:'bag',name:'Gym Bag',desc:'Waterproof, separate shoe compartment',def:1800,icon:'👜',img:'acc-bag.jpg'},
  {id:'roller',name:'Foam Roller',desc:'High-density EPP, 30cm',def:950,icon:'🔵',img:'acc-roller.jpg'},
  {id:'ankle',name:'Ankle Weights (Pair)',desc:'2KG each, adjustable strap',def:1500,icon:'🦵',img:'acc-ankle.jpg'},
];

// Store config (loaded from Firebase or localStorage)
let STORE_CFG = {
  promoBannerOn: true,
  promoText: 'FREE DELIVERY ON ORDERS OVER KSH 5,000 ◆ PREMIUM RUBBER HEX DUMBBELLS ◆ WHATSAPP ORDER 0115 228 712',
  heroTitle: 'MUFASA STORE',
  heroSub: 'Rubber-coated hex dumbbells. Singles & pairs. 2KG–35KG. Built to last a lifetime.',
  freeDeliveryMin: 5000,
  deliveryNote: 'Nairobi: 1–2 days. Other counties: 2–4 days.',
  badges: {}, // kg -> badge type: 'hot','new','sale','popular'
  stock: {},  // kg -> 'low', 'out', null
  accBadges: {},
  bundles: [],
};

let ACCS_PRICES = {};

// Default bundles
const DEFAULT_BUNDLES = [
  {
    id:'starter',name:'STARTER PACK',badge:'Best for Beginners',
    items:['8KG Pair Dumbbells','Speed Skipping Rope','Exercise Mat'],
    products:[{type:'pair',kg:8},{id:'rope'},{id:'mat'}],
    price:5450,was:6449,save:'KSH 999',saveColor:'#4caf82',
    icon:'🌱'
  },
  {
    id:'home',name:'HOME GYM BUNDLE',badge:'Most Popular 🔥',
    items:['12KG Pair + 20KG Pair','Adjustable Bench','Resistance Bands Set','Gym Bag'],
    products:[{type:'pair',kg:12},{type:'pair',kg:20},{id:'bench'},{id:'bands'},{id:'bag'}],
    price:27000,was:31200,save:'KSH 4,200',saveColor:'#4caf82',
    icon:'🏠'
  },
  {
    id:'beast',name:'BEAST MODE SET',badge:'For Advanced Athletes',
    items:['25KG Pair + 30KG Pair','Dumbbell Rack','Pull-Up Bar','Gym Gloves'],
    products:[{type:'pair',kg:25},{type:'pair',kg:30},{id:'rack'},{id:'pullup'},{id:'gloves'}],
    price:30500,was:34299,save:'KSH 3,799',saveColor:'#4caf82',
    icon:'💪'
  }
];

// ══════════════════════════════════════════
// STATE
// ══════════════════════════════════════════
let cartItems = [];
let dbFilter = 'all';
let dbSort = 'default';
let modal = {kg:20, type:'single'};

// ══════════════════════════════════════════
// INIT
// ══════════════════════════════════════════
window.addEventListener('DOMContentLoaded', () => {
  loadCart();
  loadConfig();
  buildSidebarFilters();
});

function loadConfig() {
  // Try localStorage first (set by admin panel)
  try {
    const raw = localStorage.getItem('muf_store_cfg');
    if (raw) {
      const saved = JSON.parse(raw);
      STORE_CFG = {...STORE_CFG, ...saved};
    }
    const rawP = localStorage.getItem('muf_prices');
    if (rawP) {
      const sp = JSON.parse(rawP);
      PRICES = {...PRICES, ...sp};
    }
    const rawA = localStorage.getItem('muf_acc_prices');
    if (rawA) {
      ACCS_PRICES = JSON.parse(rawA);
    }
  } catch(e) {}

  applyConfig();
  renderAll();
}

function applyConfig() {
  // Promo banner
  const pb = document.getElementById('promoBanner');
  if (STORE_CFG.promoBannerOn) {
    pb.classList.add('on');
    // Update text
    const texts = STORE_CFG.promoText ? STORE_CFG.promoText.split('◆').map(s=>s.trim()) : [];
    if (texts.length) {
      for (let i=1; i<=4; i++) {
        const el1 = document.getElementById('promoText'+i);
        const el2 = document.getElementById('promoText'+i+'b');
        const t = texts[i-1] || texts[0];
        if (el1 && t) el1.textContent = t;
        if (el2 && t) el2.textContent = t;
      }
    }
  } else {
    pb.classList.remove('on');
  }

  // Hero
  if (STORE_CFG.heroTitle) {
    const parts = STORE_CFG.heroTitle.split(' ');
    document.getElementById('storeHeroTitle').innerHTML = parts.slice(0,-1).join(' ') + ' <span>' + parts.slice(-1) + '</span>';
  }
  if (STORE_CFG.heroSub) document.getElementById('storeHeroSub').textContent = STORE_CFG.heroSub;

  // Hero badge delivery
  const free = STORE_CFG.freeDeliveryMin || 5000;
  document.getElementById('heroDelivery').textContent = 'KSH '+free.toLocaleString();
  document.getElementById('heroDeliveryLbl').textContent = 'Free Delivery Min.';
  document.getElementById('dlv-free').textContent = 'Free delivery above KSH '+free.toLocaleString();

  // Sidebar delivery
  document.getElementById('sidebarDelivery').innerHTML =
    '<div style="margin-bottom:6px"><strong style="color:var(--gl);font-size:.82rem">Free Delivery</strong><br>On orders above KSH ' + (STORE_CFG.freeDeliveryMin||5000).toLocaleString() + '</div>' +
    '<div><strong style="color:var(--w);font-size:.78rem">📍 Delivery Times</strong><br>' + (STORE_CFG.deliveryNote||'Nairobi: 1–2 days. Other counties: 2–4 days.') + '</div>';

  // Cart note
  updateCartNote();
}

function renderAll() {
  renderBundles();
  renderDBGrid(dbFilter, dbSort);
  renderAccGrid();
  renderCompTable();
}

// ══════════════════════════════════════════
// BUNDLES
// ══════════════════════════════════════════
function renderBundles() {
  const bundles = (STORE_CFG.bundles && STORE_CFG.bundles.length) ? STORE_CFG.bundles : DEFAULT_BUNDLES;
  const container = document.getElementById('bundlesGrid');
  container.innerHTML = bundles.map(b => `
    <div class="bundle-card">
      <div class="bundle-badge">🎁 ${b.badge}</div>
      <div class="bundle-name">${b.icon || '📦'} ${b.name}</div>
      <ul class="bundle-items">
        ${b.items.map(item => `<li>${item}</li>`).join('')}
      </ul>
      <div class="bundle-price-row">
        <div class="bundle-price">KSH ${Number(b.price).toLocaleString()}</div>
        <div class="bundle-was">KSH ${Number(b.was).toLocaleString()}</div>
        <div class="bundle-save">SAVE ${b.save}</div>
      </div>
      <button class="bundle-add" onclick="addBundleToCart(${JSON.stringify(b).replace(/"/g,'&quot;')})">🛒 ADD BUNDLE TO CART</button>
    </div>
  `).join('');
}

function addBundleToCart(b) {
  cartItems.push({nm: b.name, p: Number(b.price)});
  saveCart();
  toast('📦 ' + b.name + ' added to cart!');
}

// ══════════════════════════════════════════
// DUMBBELLS
// ══════════════════════════════════════════
function buildSidebarFilters() {
  const groups = [
    {label:'Light (2–8KG)', weights:[2,4,6,8]},
    {label:'Mid (10–15KG)', weights:[10,12,15]},
    {label:'Heavy (20–35KG)', weights:[20,25,30,35]},
  ];
  document.getElementById('sidebarFilters').innerHTML = groups.map(g =>
    `<label class="wt-check"><input type="checkbox" checked onchange="filterSidebar()"><span class="wt-check-label">${g.label}</span></label>`
  ).join('');
}

function filterSidebar() {
  const checks = document.querySelectorAll('#sidebarFilters input');
  const groups = ['light','mid','heavy'];
  const active = [...checks].map((c,i) => c.checked ? groups[i] : null).filter(Boolean);
  if (active.length === 3 || active.length === 0) { filterDB('all', null); return; }
  if (active.length === 1) { filterDB(active[0], null); return; }
  renderDBGrid('multi:'+active.join(','), dbSort);
}

function filterDB(f, btn) {
  dbFilter = f;
  if (btn) {
    document.querySelectorAll('#dbFilters .fbtn').forEach(b => b.classList.remove('on'));
    btn.classList.add('on');
  }
  renderDBGrid(f, dbSort);
}

function sortDB(v) {
  dbSort = v;
  renderDBGrid(dbFilter, v);
}

function getFilteredWts(f) {
  if (!f || f === 'all') return WTS;
  if (f.startsWith('multi:')) {
    const parts = f.replace('multi:','').split(',');
    return WTS.filter(kg => {
      const grp = kg<=8?'light':kg<=15?'mid':'heavy';
      return parts.includes(grp);
    });
  }
  const map = {light:[2,4,6,8], mid:[10,12,15], heavy:[20,25,30,35]};
  return map[f] || WTS;
}

function getSortedWts(wts, sort, selectedType) {
  const arr = [...wts];
  if (sort === 'price-asc') return arr.sort((a,b) => getP(a,selectedType)-getP(b,selectedType));
  if (sort === 'price-desc') return arr.sort((a,b) => getP(b,selectedType)-getP(a,selectedType));
  if (sort === 'weight-asc') return arr.sort((a,b) => a-b);
  if (sort === 'weight-desc') return arr.sort((a,b) => b-a);
  return arr;
}

function getP(kg, type) {
  const key = (type==='pair'?'p':'s') + kg;
  return PRICES[key] || 0;
}

let wTypeState = {}; // kg -> 'single'|'pair'
WTS.forEach(kg => { wTypeState[kg] = 'pair'; });

function renderDBGrid(f, sort) {
  dbFilter = f;
  const container = document.getElementById('dbGrid');
  const wts = getSortedWts(getFilteredWts(f), sort || 'default', 'pair');
  document.getElementById('dbCount').textContent = wts.length + ' products';
  if (!wts.length) {
    container.innerHTML = '<div class="empty-state"><div class="empty-state-ic">🏋️</div><div>No products in this range</div></div>';
    return;
  }
  container.innerHTML = wts.map(kg => {
    const curType = wTypeState[kg] || 'pair';
    const price = getP(kg, curType);
    const badge = STORE_CFG.badges && STORE_CFG.badges[kg];
    const stockState = STORE_CFG.stock && STORE_CFG.stock[kg];
    const isOut = stockState === 'out';
    const isLow = stockState === 'low';
    let badgeHtml = '';
    if (isOut) badgeHtml = '<div class="pcard-badge out">Out of Stock</div>';
    else if (badge) badgeHtml = '<div class="pcard-badge ' + badge.type + '">' + badge.label + '</div>';
    const stockHtml = isOut
      ? '<div class="pcard-stock low">❌ Out of stock</div>'
      : isLow
        ? '<div class="pcard-stock low">⚠️ Only a few left</div>'
        : '<div class="pcard-stock ok">✅ In stock</div>';
    return `
      <div class="pcard" onclick="openModal(${kg})">
        ${badgeHtml}
        <div class="pcard-img">🏋️${isOut?'<div class="stock-ov">OUT OF STOCK</div>':''}</div>
        <div class="pcard-body">
          <div class="pcard-kg">${kg}<span>KG</span></div>
          <div class="pcard-type-row">
            <button class="ptbtn ${curType==='single'?'on':''}" onclick="event.stopPropagation();setWType(${kg},'single',this)">Single</button>
            <button class="ptbtn ${curType==='pair'?'on':''}" onclick="event.stopPropagation();setWType(${kg},'pair',this)">Pair</button>
          </div>
          <div class="pcard-price" id="ppr-${kg}">KSH ${price.toLocaleString()}<small> / ${curType}</small></div>
          ${stockHtml}
          <button class="pcard-add" onclick="event.stopPropagation();addDB(${kg})" id="padd-${kg}" ${isOut?'disabled':''}>
            ${isOut?'OUT OF STOCK':'+ ADD TO CART'}
          </button>
        </div>
      </div>
    `;
  }).join('');
}

function setWType(kg, type, btn) {
  wTypeState[kg] = type;
  const row = btn.closest('.pcard-type-row');
  row.querySelectorAll('.ptbtn').forEach(b => b.classList.remove('on'));
  btn.classList.add('on');
  const price = getP(kg, type);
  const prEl = document.getElementById('ppr-'+kg);
  if (prEl) prEl.innerHTML = 'KSH ' + price.toLocaleString() + '<small> / ' + type + '</small>';
}

function addDB(kg) {
  const type = wTypeState[kg] || 'pair';
  const price = getP(kg, type);
  cartItems.push({nm: kg+'KG '+capitalise(type)+' Dumbbells', p: price});
  saveCart();
  toast('🏋️ ' + kg + 'KG ' + capitalise(type) + ' added!');
}

// ══════════════════════════════════════════
// ACCESSORIES
// ══════════════════════════════════════════
function renderAccGrid() {
  const container = document.getElementById('accGrid');
  container.innerHTML = ACCS.map(a => {
    const price = ACCS_PRICES[a.id] || a.def;
    return `
      <div class="acc-card">
        <div class="acc-card-img">${a.icon}</div>
        <div class="acc-card-body">
          <div class="acc-nm">${a.name}</div>
          <div class="acc-ds">${a.desc}</div>
          <div class="acc-pr">KSH ${price.toLocaleString()}</div>
          <button class="pcard-add" onclick="addAcc('${a.id}','${a.name}',${price})">+ ADD TO CART</button>
        </div>
      </div>
    `;
  }).join('');
}

function addAcc(id, name, price) {
  cartItems.push({nm: name, p: price});
  saveCart();
  toast('🎽 ' + name + ' added!');
}

// ══════════════════════════════════════════
// COMPARISON TABLE
// ══════════════════════════════════════════
function renderCompTable() {
  const tbody = document.getElementById('compBody');
  tbody.innerHTML = WTS.map(kg => {
    const sp = getP(kg,'single'), pp = getP(kg,'pair');
    const spkg = (sp/kg).toFixed(0), ppkg = (pp/(kg*2)).toFixed(0);
    const save = (sp*2 - pp);
    const savePct = save > 0 ? Math.round((save/(sp*2))*100) : 0;
    return `<tr>
      <td><strong>${kg}KG</strong></td>
      <td class="g">KSH ${sp.toLocaleString()}</td>
      <td class="g">KSH ${pp.toLocaleString()}</td>
      <td class="dim">KSH ${spkg}/kg</td>
      <td class="dim">KSH ${ppkg}/kg</td>
      <td>${save>0?'<span class="comp-save-tag">SAVE '+savePct+'%</span>':'<span style="color:var(--dim);font-size:.75rem">—</span>'}</td>
    </tr>`;
  }).join('');
}

// ══════════════════════════════════════════
// MODAL
// ══════════════════════════════════════════
function openModal(kg) {
  modal.kg = kg;
  modal.type = wTypeState[kg] || 'pair';
  updateModal();
  document.getElementById('pModal').classList.add('open');
  document.body.style.overflow = 'hidden';
}
function closeModal() {
  document.getElementById('pModal').classList.remove('open');
  document.body.style.overflow = '';
}
function pmSetType(t) {
  modal.type = t;
  document.getElementById('pmSingle').classList.toggle('on', t==='single');
  document.getElementById('pmPair').classList.toggle('on', t==='pair');
  updateModal();
}
function updateModal() {
  const {kg, type} = modal;
  const price = getP(kg, type);
  const stockState = STORE_CFG.stock && STORE_CFG.stock[kg];
  const badge = STORE_CFG.badges && STORE_CFG.badges[kg];
  document.getElementById('pmKg').innerHTML = kg + '<span>KG</span>';
  document.getElementById('pmName').textContent = 'Rubber Hex Dumbbell — MUFASA STRENGTH';
  document.getElementById('pmPrice').textContent = 'KSH ' + price.toLocaleString();
  document.getElementById('pmPer').textContent = '/ ' + type;
  document.getElementById('pmSpecKg').textContent = kg + 'KG';
  // Badge
  const bdEl = document.getElementById('pmBadge');
  if (badge) {
    bdEl.innerHTML = '<div class="pcard-badge '+badge.type+'" style="margin-bottom:8px;position:static;display:inline-block">'+badge.label+'</div>';
  } else { bdEl.innerHTML = ''; }
  // Stock
  const stEl = document.getElementById('pmStock');
  if (stockState === 'out') { stEl.className = 'pm-stock-row low'; stEl.textContent = '❌ Currently out of stock'; }
  else if (stockState === 'low') { stEl.className = 'pm-stock-row low'; stEl.textContent = '⚠️ Only a few units left — order now!'; }
  else { stEl.className = 'pm-stock-row ok'; stEl.textContent = '✅ In stock — ready to ship'; }
  // Buttons
  const isOut = stockState === 'out';
  const addBtn = document.getElementById('pmAddBtn');
  addBtn.disabled = isOut;
  addBtn.textContent = isOut ? '❌ OUT OF STOCK' : '🛒 ADD TO CART';
}
function pmAddToCart() {
  const {kg, type} = modal;
  const price = getP(kg, type);
  cartItems.push({nm: kg+'KG '+capitalise(type)+' Dumbbells', p: price});
  saveCart();
  closeModal();
  toast('🏋️ ' + kg + 'KG ' + capitalise(type) + ' added to cart!');
}
function pmOrderWA() {
  const {kg, type} = modal;
  const price = getP(kg, type);
  const orderId = genOrderId();
  const now = new Date();
  const dateStr = now.toLocaleDateString('en-KE',{day:'2-digit',month:'short',year:'numeric'});
  const timeStr = now.toLocaleTimeString('en-KE',{hour:'2-digit',minute:'2-digit'});
  const divider = '━━━━━━━━━━━━━━━━━━━━━━';
  const thinDiv = '┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄';

  const msg =
`🦁 *MUFASA STRENGTH EQUIPMENT*
_Premium Rubber Hex Dumbbells_
📍 Nairobi, Kenya  •  wa.me/254115228712
${divider}

🧾 *ORDER INVOICE*
${thinDiv}
📋 Order ID: *${orderId}*
📅 Date: ${dateStr}  •  ${timeStr}
${divider}

🛒 *ITEMS ORDERED*
${thinDiv}
🔶 *${kg}KG Rubber Hex Dumbbell (${capitalise(type)})*
    KSH ${price.toLocaleString()}
${divider}

💰 *ORDER SUMMARY*
${thinDiv}
💵 *TOTAL:  KSH ${price.toLocaleString()}*
${divider}

📦 *DELIVERY INFO*
${thinDiv}
• Nairobi: 1–2 business days
• Other counties: 2–4 business days
• Nationwide delivery across all 47 counties
${divider}

💳 *PAYMENT ON DELIVERY*
Accepted: M-Pesa / Cash on Delivery

_Please reply with your:_
📍 Delivery address
📞 Phone number
${divider}
_Thank you for choosing MUFASA STRENGTH! 🦁_
_Forge Your Legacy 💪_`;

  window.open('https://wa.me/254115228712?text='+encodeURIComponent(msg),'_blank');
}

// ══════════════════════════════════════════
// CART — shared with homepage via muf_cart localStorage key
// ══════════════════════════════════════════
function openCart() {
  try { window.parent.postMessage({type:'muf_open_cart'}, '*'); } catch(e) {}
}
function closeCart() {
  try { window.parent.postMessage({type:'muf_close_cart'}, '*'); } catch(e) {}
}

function updateCartUI() {
  // Just save — homepage cart handles the display
  saveCart();
}

function updateCartNote(total) {}

function removeFromCart(idx) {
  cartItems.splice(idx, 1);
  saveCart();
}

function clearCart() {
  if (!cartItems.length) return;
  if (confirm('Clear all items from your cart?')) { cartItems = []; saveCart(); toast('Cart cleared'); }
}

const LOGO_B64='data:image/png;base64,';
function genOrderId(){
  const chars='ABCDEFGHJKLMNPQRSTUVWXYZ23456789';
  let id='MUF-';
  for(let i=0;i<8;i++) id+=chars[Math.floor(Math.random()*chars.length)];
  return id;
}
function checkoutWA() {
  if (!cartItems.length) { toast('Your cart is empty'); return; }

  const grouped={};
  cartItems.forEach(x=>{
    if(!grouped[x.nm]) grouped[x.nm]={nm:x.nm,p:x.p,qty:0};
    grouped[x.nm].qty++;
  });
  const lines=Object.values(grouped);

  const total=cartItems.reduce((s,x)=>s+x.p,0);
  const orderId=genOrderId();
  const now=new Date();
  const dateStr=now.toLocaleDateString('en-KE',{day:'2-digit',month:'short',year:'numeric'});
  const timeStr=now.toLocaleTimeString('en-KE',{hour:'2-digit',minute:'2-digit'});

  const divider='━━━━━━━━━━━━━━━━━━━━━━';
  const thinDiv='┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄';

  const itemLines=lines.map(x=>{
    const lineTotal=x.p*x.qty;
    const qty=x.qty>1?` ×${x.qty}`:'';
    return `🔶 *${x.nm}*${qty}\n    KSH ${x.p.toLocaleString()}${x.qty>1?' × '+x.qty+' = KSH '+lineTotal.toLocaleString():''}`;
  }).join('\n');

  const msg=
`🦁 *MUFASA STRENGTH EQUIPMENT*
_Premium Rubber Hex Dumbbells_
📍 Nairobi, Kenya  •  wa.me/254115228712
${divider}

🧾 *ORDER INVOICE*
${thinDiv}
📋 Order ID: *${orderId}*
📅 Date: ${dateStr}  •  ${timeStr}
${divider}

🛒 *ITEMS ORDERED*
${thinDiv}
${itemLines}
${divider}

💰 *ORDER SUMMARY*
${thinDiv}
💵 *TOTAL:  KSH ${total.toLocaleString()}*
${divider}

📦 *DELIVERY INFO*
${thinDiv}
• Nairobi: 1–2 business days
• Other counties: 2–4 business days
• Nationwide delivery across all 47 counties
${divider}

💳 *PAYMENT ON DELIVERY*
Accepted: M-Pesa / Cash on Delivery

_Please reply with your:_
📍 Delivery address
📞 Phone number
${divider}
_Thank you for choosing MUFASA STRENGTH! 🦁_
_Forge Your Legacy 💪_`;

  window.open('https://wa.me/254115228712?text='+encodeURIComponent(msg),'_blank');
}

function saveCart() {
  try { localStorage.setItem('muf_cart', JSON.stringify(cartItems)); } catch(e){}
  // Notify parent homepage to sync cart instantly
  try { window.parent.postMessage({type:'muf_cart_update', cart: cartItems}, '*'); } catch(e){}
}
function loadCart() {
  try { const r = localStorage.getItem('muf_cart'); if (r) { cartItems = JSON.parse(r); } } catch(e){}
}

// Listen for cart clear from parent homepage
window.addEventListener('message', function(e) {
  if (e.data && e.data.type === 'muf_cart_clear') {
    cartItems = [];
    try { localStorage.setItem('muf_cart', '[]'); } catch(ex){}
    updateCartUI();
    updateCartNote();
  }
});

// ══════════════════════════════════════════
// HELPERS
// ══════════════════════════════════════════
function toast(msg, d=2600) {
  const t = document.getElementById('toast');
  t.textContent = msg;
  t.classList.add('show');
  setTimeout(() => t.classList.remove('show'), d);
}
function capitalise(s) { return s.charAt(0).toUpperCase() + s.slice(1); }
function scrollToSec(id) {
  document.getElementById(id).scrollIntoView({behavior:'smooth', block:'start'});
  document.querySelectorAll('.sb-link').forEach(l => l.classList.remove('act'));
  event.target.classList.add('act');
}

// ══════════════════════════════════════════
// PARENT MESSAGE LISTENER (for admin config updates)
// ══════════════════════════════════════════
window.addEventListener('message', (e) => {
  if (e.data && e.data.type === 'muf_store_config') {
    STORE_CFG = {...STORE_CFG, ...e.data.cfg};
    applyConfig();
    renderAll();
  }
  if (e.data && e.data.type === 'muf_store_prices') {
    PRICES = {...PRICES, ...e.data.prices};
    renderDBGrid(dbFilter, dbSort);
    renderCompTable();
  }
  if (e.data && e.data.type === 'muf_acc_prices') {
    ACCS_PRICES = {...ACCS_PRICES, ...e.data.prices};
    renderAccGrid();
  }
});
</script>
</body>
</html>
