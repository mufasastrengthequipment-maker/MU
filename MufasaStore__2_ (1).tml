      </div>
      <div class="filter-row" id="dbFilters">
        <button class="fbtn on" onclick="filterDB('all',this)">ALL</button>
        <button class="fbtn" onclick="filterDB('light',this)">LIGHT (2–8KG)</button>
        <button class="fbtn" onclick="filterDB('mid',this)">MID (10–15KG)</button>
        <button class="fbtn" onclick="filterDB('heavy',this)">HEAVY (20–35KG)</button>
